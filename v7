function isExcludedDriveName_(name, isFolder) {
 if (!name) return false;
 var key = normalizeExclusionName_(name);
 if (hasRestrictedMarker_(name)) return true;

 var exactSet = getExcludeExactNameSet_();
 if (exactSet[key]) return true;

 for (var i = 0; i < EXCLUDE_NAME_PATTERNS.length; i++) {
  var pattern = normalizeExclusionName_(EXCLUDE_NAME_PATTERNS[i]);
  if (!pattern) continue;
  if (CONFIG.INCLUDE_SCREENSHOT_FOLDERS_FOR_IMAGES && isFolder && isScreenshotFolderName_(pattern)) {
   continue;
  }
  if (key.indexOf(pattern) >= 0) return true;
 }
 return false;
}

function getExcludeExactNameSet_() {
 var set = {};
 for (var i = 0; i < EXCLUDE_EXACT_NAMES.length; i++) {
  var key = normalizeExclusionName_(EXCLUDE_EXACT_NAMES[i]);
  if (key) set[key] = true;
 }
 return set;
}

function hasRestrictedMarker_(name) {
 return /[\[\{]\s*[rR]\s*[\]\}]/.test(String(name || ""));
}

function normalizeExclusionName_(name) {
 return String(name || "")
  .toLowerCase()
  .replace(/\u00ae/g, "")
  .replace(/\u00c2\u00ae/g, "")
  .replace(/Ãƒâ€šÃ‚®/g, "")
  .replace(/Ã‚®/g, "")
  .replace(/&/g, " ")
  .replace(/[^a-z0-9]+/g, " ")
  .replace(/\s+/g, " ")
