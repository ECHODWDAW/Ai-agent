 // Preview mode mirrors PRODUCTION routing: derive it from the sender domain
 // in B2 using the same check the live agents route on. An @x-phy.com /
 // @flexxon.com sender previews INTERNAL; anything else previews EXTERNAL, so
 // the external KB path and external tier rules are actually exercised. Blank
 // sender falls back to INTERNAL (the historical preview default).
 var previewModeInternal = !sender || isXphyInternalSender_(sender);
 AGENT_MODE_ = previewModeInternal ? "INTERNAL" : "EXTERNAL";
 var subject = String(sheet.getRange("B3").getValue() || "").trim();
 var body = extractLatestReplyText_(String(sheet.getRange("B4").getValue() || "").trim());

 clearEmailTestPreviewOutput_(sheet);
 sheet.getRange("B8").setValue(getFormattedTimestamp_());

 if (!body) {
  sheet.getRange("B9").setValue("Paste a sample customer email into B4, then run this again.");
  showConfigSheetToast_("Add a sample email body first.");
  return;
 }

 try {
  sheet.getRange("B9").setValue("Running preview. This calls Claude and uses tokens, but no email will be sent.");
  SpreadsheetApp.flush();
  clearEditableConfigCache_();

  PREVIEW_STAGE_ = "classifying email";
  var previewEscalationCheckText = getEscalationCheckText_(body);
  var classification = classifyEmail_(subject, body, { gateText: previewEscalationCheckText });
  PREVIEW_STAGE_ = "searching knowledge base (opens the inventory sheet + crawler workbook)";
  var knowledgeContext = searchKnowledgeBase(subject, getForwardedSearchTextOrDefault_(body), classification);
  PREVIEW_STAGE_ = "calling Claude";
  var aiReply = callClaude(sender, senderName, subject, body, knowledgeContext.text);
  PREVIEW_STAGE_ = "building email HTML (banner + buttons from inventory)";
  var finalHtml = buildEmailHtmlWithImages_(aiReply, [], subject, body);
  PREVIEW_STAGE_ = "building preview analysis";
  var previewAnalysis = getEmailPreviewAnalysis_(subject, body, classification, knowledgeContext);
  var previewButtons = extractEmailPreviewButtons_(buildActionButtons_(subject, body));
  PREVIEW_STAGE_ = "writing preview to the sheet";

  sheet.getRange("B9").setValue("Preview generated. No email was sent.");
  sheet.getRange("B10").setValue(previewAnalysis.categories.join("; "));
  sheet.getRange("B11").setValue(previewAnalysis.products.join("; "));
  sheet.getRange("B12").setValue(getEmailPreviewDocumentSummary_(knowledgeContext, previewAnalysis));
  sheet.getRange("B13").setValue(getEmailPreviewFilesSummary_(knowledgeContext, previewAnalysis));
  sheet.getRange("B14").setValue(LAST_CLAUDE_MODEL_USED_ || "");
  sheet.getRange("A15").setValue("Email reply preview (readable)");
  var routingNote = "[PREVIEW MODE: " + (isExternalMode_() ? "EXTERNAL" : "INTERNAL")
   + " - derived from the sender domain in B2. This is the pipeline (KB + tier rules) that ran.]\n\n";
  var previewBulk = isBulkPricingInquiry_(subject, body);
  var previewBulkOnly = previewBulk && !hasNonPricingQuestions_(subject, body);
  if (classification.shouldEscalate || needsHumanEscalation_(subject, previewEscalationCheckText) || previewBulkOnly) {
   routingNote += "[PRODUCTION ROUTING: this email would be ESCALATED with the generic acknowledgement - the reply below would NOT be sent. Reason: "
    + (classification.escalationReason || (previewBulkOnly ? "bulk pricing only" : "sentiment/risk escalation")) + "]\n\n";
  } else if (previewBulk) {
   routingNote += "[PRODUCTION ROUTING: mixed bulk-pricing email - pricing request forwarded to interal team, reply below IS sent]\n\n";
  }
  sheet.getRange("B15").setValue(routingNote + formatEmailForReadableSheetPreview_(finalHtml));
  sheet.getRange("B15").setVerticalAlignment("top");
  writeEmailPreviewButtons_(sheet, previewButtons);
  sheet.getRange("B22").setValue("If the draft looks wrong, edit AI_PROMPT_RULES, translate/refresh rules, then run this preview again.");
  showConfigSheetToast_("Email test preview generated.");
  AGENT_MODE_ = "INTERNAL"; // restore default; preview must not leave the process in EXTERNAL mode
 } catch (e) {
  sheet.getRange("B9").setValue("Preview failed at stage [" + PREVIEW_STAGE_ + "]: " + e.message);
  log("Preview failed at stage [" + PREVIEW_STAGE_ + "]: " + e.message);
  try { debugConfiguredIds_(); } catch (diagError) { log(" Diagnostic also failed: " + diagError.message); }
  showConfigSheetToast_("Email test preview failed - see B9 and the execution log.");
  throw e;
 }
}

