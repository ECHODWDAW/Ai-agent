function buildInventoryHeaderMap_(headerRow) {
 var map = {};
 for (var i = 0; i < headerRow.length; i++) {
  var key = normalizeInventoryHeader_(headerRow[i]);
  if (key) map[key] = i;
 }
 return map;
}

function normalizeInventoryHeader_(header) {
 return String(header || "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "")
  .trim();
}

function getInventoryCell_(row, headers, key) {
 var index = headers[key];
 if (index === undefined) return "";
 return String(row[index] || "").trim();
}

function extractDriveIdFromUrl_(url) {
 var text = String(url || "");
 var patterns = [
  /\/file\/d\/([a-zA-Z0-9_-]+)/,
  /\/document\/d\/([a-zA-Z0-9_-]+)/,
  /\/spreadsheets\/d\/([a-zA-Z0-9_-]+)/,
  /\/presentation\/d\/([a-zA-Z0-9_-]+)/,
  /\/folders\/([a-zA-Z0-9_-]+)/,
  /[?&]id=([a-zA-Z0-9_-]+)/,
 ];
 for (var i = 0; i < patterns.length; i++) {
  var match = text.match(patterns[i]);
  if (match && match[1]) return match[1];
 }
 return "";
}

function isInventoryFolderType_(type) {
 var normalized = normalizeExclusionName_(type);
 return normalized === "folder" || normalized === "folder root" || normalized.indexOf("shortcut") >= 0;
}

function isExcludedInventoryRow_(name, path) {
 if (isExcludedDriveName_(name, false)) return true;
 if (hasRestrictedMarker_(path)) return true;
 return hasInventoryPathHardExclude_(path);
}

function hasInventoryPathHardExclude_(path) {
 var key = normalizeExclusionName_(path);
 if (!key) return false;
 var hardPatterns = [
  "for testing use",
  "internal use for training",
  "to be uploaded",
  "deepfake internal uat",
  "old copies",
  "demo resources",
  "mc feedback form",
  "for marketing",
  "faq manager",
  "duplicate",
 ];
 for (var i = 0; i < hardPatterns.length; i++) {
  if (key.indexOf(hardPatterns[i]) >= 0) return true;
 }
 return false;
}

function inferMimeTypeFromInventoryType_(type) {
 var normalized = normalizeExclusionName_(type);
 if (normalized.indexOf("google doc") >= 0) return "application/vnd.google-apps.document";
 if (normalized.indexOf("google sheet") >= 0) return "application/vnd.google-apps.spreadsheet";
 if (normalized.indexOf("pdf") >= 0) return "application/pdf";
