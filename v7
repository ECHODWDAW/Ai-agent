function debugForwardedEmailParsing_() {
 loadSavedConfigSpreadsheetId_();
 if (!CONFIG.CONFIG_SPREADSHEET_ID) throw new Error("Run setupEditableConfigTemplate_() first, or set CONFIG_SPREADSHEET_ID.");
 var sheet = ensureEmailTestPreviewSheet_(SpreadsheetApp.openById(CONFIG.CONFIG_SPREADSHEET_ID));
 var sender = String(sheet.getRange("B2").getValue() || "");
 var body = String(sheet.getRange("B4").getValue() || "");
 if (!body) {
  log("Paste a sample email body into EMAIL_TEST_PREVIEW B4 first.");
  return;
 }

 var context = getForwardedEmailContext_(body);
 log("=== FORWARDED EMAIL TEST ===");
 if (!context) {
  log("No forwarded or quoted conversation found. Ethan will handle this as an ordinary email, exactly as before.");
  return;
 }
 var info = LAST_FORWARD_CONTEXT_;
 log("Detected as: " + (info.kind === "forward" ? "a forwarded email" : "an email with an earlier conversation quoted below it"));
 log("Messages found: " + info.messageCount + (info.omittedMessages ? " (" + info.omittedMessages + " dropped because the thread was very long)" : ""));
 log("Newest message from: " + (info.originalFrom || "(could not read)"));
 log("Newest message date: " + (info.originalDate || "(could not read)"));
 log("Covering note: " + info.noteType
  + (info.noteType === "none" ? " (nothing was written above the forward)" : "")
  + (info.noteType === "handoff" ? " (a hand-off such as 'please help with this' - Ethan will answer the forwarded content)" : "")
  + (info.noteType === "directed" ? " (contains its own instruction, which Ethan will prioritise)" : ""));
 log("Body length: " + body.length + " characters in, " + context.length + " characters of context out.");
 log("--- WHAT ETHAN WILL READ ---");
 log(context.substring(0, 3000));
 log("--- RULES ETHAN WILL FOLLOW ---");
 log(getForwardedEmailInstructionForCurrentEmail_(sender, extractSenderName(sender)));
}
