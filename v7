function uniqueButtons_(buttons) {
 var seen = {};
 var urlIndex = {};
 var out = [];
 for (var i = 0; i < buttons.length; i++) {
  if (!buttons[i] || !buttons[i].url) continue;
  var url = String(buttons[i].url);
  var key = String(buttons[i].label || "") + "|" + url;
  if (seen[key]) continue;
  seen[key] = true;
  // Different product buttons may intentionally point to the same generic
  // product hub, so those are deduplicated by exact label+URL only. Any
  // other URL appearing twice with different labels (for example the
  // editable Support Links sheet labelling the Secure SSD page one way
  // while the code labels it another) is the same destination and must
  // collapse into a single button.
  if (!GENERIC_HUB_BUTTON_URLS_[url]) {
   if (urlIndex.hasOwnProperty(url)) {
    // Prefer the canonical label if either duplicate carries it.
    if (String(buttons[i].label || "") === CANONICAL_SECURE_SSD_BUTTON_LABEL_) {
     out[urlIndex[url]] = buttons[i];
    }
    continue;
   }
   urlIndex[url] = out.length;
  }
  out.push(buttons[i]);
 }
 return out;
}


