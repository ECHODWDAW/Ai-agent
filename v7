function scoreProductProfile_(text, profile) {
 var strongScore = countMatchedTerms_(text, profile.strongTerms || []);
 var weakScore = countMatchedTerms_(text, profile.weakTerms || []);
 return {
  strongScore: strongScore,
  weakScore: weakScore,
  score: strongScore * 3 + weakScore,
 };
}

function countMatchedTerms_(text, terms) {
 var count = 0;
 for (var i = 0; i < terms.length; i++) {
  if (text.indexOf(terms[i]) >= 0) count++;
 }
 return count;
}

function getProductIntentProfiles_() {
 var profiles = [];
 for (var productLine in PRODUCT_BUTTON_CATALOG_) {
  var productConfig = PRODUCT_BUTTON_CATALOG_[productLine];
  profiles.push({
   label: productLine,
   strongTerms: (productConfig.strongTerms || []).slice(),
   weakTerms: (productConfig.weakTerms || []).slice(),
  });
 }
 if (CONFIG.SERVER_DEFENDER_ENABLED) {
  profiles.push({ label: "Server Defender", strongTerms: ["server_defender"], weakTerms: ["server", "datacenter", "data center", "rack", "enterprise", "data centre"] });
 } else {
  profiles.push({ label: "Server Defender", strongTerms: ["server_defender"], weakTerms: [] });
 }
 for (var i = 0; i < profiles.length; i++) {
  profiles[i].terms = (profiles[i].strongTerms || []).concat(profiles[i].weakTerms || []);
 }
 return profiles;
}

function scoreImageCandidate_(fileMeta, intent) {
 var name = normalizeProductPhrases_(fileMeta.name || "");
 var folderText = normalizeProductPhrases_(getFolderTextForFile_(fileMeta));
 var haystack = name + " " + folderText;
 var score = 0;

 if (!isCandidateAllowedForIntent_(fileMeta, intent)) return 0;
 if (isImageSourceFile_(fileMeta)) score += 10;
 if (isImageMimeType_(fileMeta.mimeType)) score += 12;
 if (haystack.indexOf("screenshot") >= 0 || haystack.indexOf("screen shot") >= 0) score += 8;
 if (haystack.indexOf("image") >= 0 || haystack.indexOf("photo") >= 0 || haystack.indexOf("diagram") >= 0) score += 6;
 if (haystack.indexOf("datasheet") >= 0 || haystack.indexOf("data sheet") >= 0 || haystack.indexOf("brochure") >= 0) score += 5;
 if (haystack.indexOf("demo") >= 0 || haystack.indexOf("guide") >= 0) score += 2;

 var strictTerms = getStrictProductImageTerms_(intent.label);
 for (var i = 0; i < strictTerms.length; i++) {
  if (haystack.indexOf(normalizeProductPhrases_(strictTerms[i])) >= 0) score += 10;
 }

 return score;
}

function isCandidateAllowedForIntent_(fileMeta, intent) {
 if (!isImageSourceFile_(fileMeta)) return false;

