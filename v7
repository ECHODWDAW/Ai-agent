function refreshExternalPartnerDbStatus_() {
 loadSavedConfigSpreadsheetId_();
 var sheet = getExternalKnowledgeSheetOrDie_();
 var lastRow = sheet.getLastRow();
 if (lastRow < 1) return { ok: 0, skipped: 0, total: 0 };

 var colA = sheet.getRange(1, 1, lastRow, 1).getValues(); // Drive Link column, incl. header
 var now = getFormattedTimestamp_();

 // Clear any previous status columns (B:E) so removed links leave no stale rows.
 var maxRows = sheet.getMaxRows();
 sheet.getRange(1, 2, maxRows, 4).clearContent();

 // Status headers live in B1:E1; A1 stays "Drive Link".
 sheet.getRange(1, 2, 1, 4).setValues([["Name", "Type", "Status", "Last Refreshed"]]);
 sheet.getRange(1, 2, 1, 4).setFontWeight("bold");

 var okCount = 0, skippedCount = 0, dataRows = 0;
 var seenIds = {};
 var out = []; // one B:E row per source row (row 2 downward), kept aligned to column A

 for (var r = 1; r < colA.length; r++) { // skip header row
  var url = String(colA[r][0] || "").trim();
  if (!url) { out.push(["", "", "", ""]); continue; }
  dataRows++;

  var metadata = getExternalDriveFileMetadata_(url);
  if (!metadata) {
   skippedCount++;
   out.push(["(unresolved)", "-", "SKIPPED: Drive metadata could not be read - folder missing, moved, or ethan@x-phy.com lacks access.", now]);
   continue;
  }
  if (seenIds[metadata.id]) {
   out.push([metadata.title, "-", "DUPLICATE: already listed above; ignored by the resolver.", now]);
   continue;
  }
  seenIds[metadata.id] = true;

  var isFolder = isDriveFolderUrl_(url);
  var typeLabel = isFolder ? "Folder" : "File";
  var productLine = inferExternalCategoryFromTitle_(metadata.title);

  if (isRestrictedExternalMetadata_(metadata)) {
   skippedCount++;
   out.push([metadata.title, typeLabel, "SKIPPED [R]: restricted from external sharing by name marker.", now]);
   continue;
  }

  var statusText;
  if (isFolder) {
   var counts = countDriveFolderItems_(metadata.id);
   statusText = "OK: " + counts.total + " item" + (counts.total === 1 ? "" : "s")
    + (counts.subfolders ? " (" + counts.subfolders + " subfolder" + (counts.subfolders === 1 ? "" : "s") + ")" : "")
    + ". Category: " + productLine + ".";
  } else {
   statusText = "OK: single file. Category: " + productLine + ".";
  }
  okCount++;
  out.push([metadata.title, typeLabel, statusText, now]);
 }

 if (out.length > 0) {
  sheet.getRange(2, 2, out.length, 4).setValues(out);
 }
 sheet.setFrozenRows(1);
 sheet.setColumnWidth(1, 340);
 sheet.setColumnWidth(2, 260);
 sheet.setColumnWidth(3, 70);
 sheet.setColumnWidth(4, 460);
 sheet.setColumnWidth(5, 160);

 // Force the resolver to re-read column A on the next email.
 EXTERNAL_PARTNER_LINKS_CACHE_ = null;
 try { CacheService.getScriptCache().remove(EXTERNAL_PARTNER_LINKS_CACHE_KEY_); } catch (e) {}

 log(" External partner DB refreshed in place: " + okCount + " OK, " + skippedCount + " skipped, " + dataRows + " link row(s).");
 return { ok: okCount, skipped: skippedCount, total: dataRows };
}

function isDriveFolderUrl_(url) {
 return /\/folders\//i.test(String(url || ""));
}

function countDriveFolderItems_(folderId) {
 // Shallow count of direct children (files + subfolders) for the status view.
 var total = 0;
 var subfolders = 0;
 try {
  var folder = DriveApp.getFolderById(folderId);
  var files = folder.getFiles();
  while (files.hasNext()) { files.next(); total++; }
