// Manual, draft-only reprocessing for an existing conversation. Apply the
// AI-Redraft Gmail label to exactly one thread, then run the entry point that
// matches the agent. This deliberately bypasses the normal "new inbound
// message" and stored thread-count checks, but never enables sending.
function createManualRedraftInternal() {
 AGENT_MODE_ = "INTERNAL";
 createManualRedraftForSelectedThread_();
}

function createManualRedraftExternal() {
 AGENT_MODE_ = "EXTERNAL";
 createManualRedraftForSelectedThread_();
}

function createManualRedraftForSelectedThread_() {
 var lock = LockService.getScriptLock();
 if (!lock.tryLock(5000)) throw new Error("Ethan is already running. Try the manual redraft again after the current run finishes.");

 var originalAutoReply = CONFIG.ENABLE_AUTO_REPLY;
 var originalInternalForwarding = CONFIG.ENABLE_INTERNAL_FORWARDING;
 try {
  validateConfig_();
  var labelName = String(CONFIG.MANUAL_REDRAFT_LABEL_NAME || "AI-Redraft");
  var redraftLabel = ensureLabelExists(labelName);
  var threads = GmailApp.search("label:" + labelName, 0, 2);
  if (threads.length === 0) {
   throw new Error('No thread selected. Apply the Gmail label "' + labelName + '" to exactly one thread, then run this function again.');
  }
  if (threads.length > 1) {
   throw new Error('More than one thread has the Gmail label "' + labelName + '". Leave it on exactly one thread and try again.');
  }

  var thread = threads[0];
  var message = getLatestInboundMessageForManualRedraft_(thread);
  if (!message) throw new Error("The selected thread contains no inbound message to redraft.");

  var sender = message.getFrom();
  var senderIsInternal = isXphyInternalSender_(sender);
  if (isExternalMode_() ? senderIsInternal : !senderIsInternal) {
   throw new Error("The selected message belongs to the " + (senderIsInternal ? "internal" : "external") + " agent. Run the matching manual redraft function instead.");
  }

  // Safety invariant: this path may create a Gmail draft, but it must never
  // send a customer reply or an internal escalation email.
  CONFIG.ENABLE_AUTO_REPLY = false;
  CONFIG.ENABLE_INTERNAL_FORWARDING = false;
  warmKnowledgeBaseCache_();
  processEmail(thread, message);
  redraftLabel.removeFromThread(thread);
  log(' Manual draft-only reprocessing completed for "' + message.getSubject() + '". The ' + labelName + " label was removed.");
 } finally {
  CONFIG.ENABLE_AUTO_REPLY = originalAutoReply;
  CONFIG.ENABLE_INTERNAL_FORWARDING = originalInternalForwarding;
  lock.releaseLock();
 }
}

function getLatestInboundMessageForManualRedraft_(thread) {
 var selfEmails = getSelfEmailSet_();
 var messages = thread.getMessages();
 for (var i = messages.length - 1; i >= 0; i--) {
  var from = extractEmailAddress(messages[i].getFrom()).toLowerCase();
  if (!selfEmails[from]) return messages[i];
 }
 return null;
}

