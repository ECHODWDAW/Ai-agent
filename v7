 cleaned = cleaned.replace(/(?:^|\n)[^\n]{0,140}\b(?:unsubscribe|manage (?:your )?preferences|view (?:this|it) in (?:your )?browser|do not reply to this)\b[^\n]*/gi, "");
 cleaned = cleaned.split("\n").map(function(line) {
  return line.replace(/^[ \t]*(?:>[ \t]?)+/, "");
 }).join("\n");
 return cleaned.replace(/[ \t]+\n/g, "\n").replace(/\n{3,}/g, "\n\n").trim();
}

function collectForwardSeparators_(text) {
 var found = [];
 function addAll(pattern, kind) {
  var rx = new RegExp(pattern.source, pattern.flags.indexOf("g") >= 0 ? pattern.flags : pattern.flags + "g");
  var match;
  while ((match = rx.exec(text)) !== null) {
   found.push({ index: match.index, length: match[0].length, kind: kind, text: match[0] });
   if (match.index === rx.lastIndex) rx.lastIndex++;
  }
 }
 for (var i = 0; i < FORWARD_DIVIDER_PATTERNS_.length; i++) addAll(FORWARD_DIVIDER_PATTERNS_[i], "divider");
 addAll(FORWARD_QUOTED_HEADER_RE_, "headers");
 addAll(FORWARD_INLINE_QUOTE_RE_, "inline");

 found.sort(function(a, b) { return (a.index - b.index) || (b.length - a.length); });

 var deduped = [];
 var lastEnd = null; // null, not -1: a separator sitting at index 0 is the
 // first message of the conversation and must never be discarded.
 for (var j = 0; j < found.length; j++) {
  if (lastEnd !== null && found[j].index <= lastEnd + 2) continue;
  deduped.push(found[j]);
  lastEnd = found[j].index + found[j].length;
 }
 return deduped;
}

function parseInlineQuoteAttribution_(separatorText) {
 // Strip the ">" quote markers per line only - a global strip would also eat
 // the closing bracket of "<name@example.com>".
 var line = String(separatorText || "").split("\n").map(function(part) {
  return part.replace(/^[ \t>]+/, "");
 }).join(" ").replace(/\s+/g, " ").trim();
 var attribution = line.replace(/^On[ \t]+/i, "").replace(/[ \t]*wrote:[ \t]*$/i, "").trim();
 var from = "";
 var date = attribution;
 var emailMatch = attribution.match(/([^,]*<[^>]+>)\s*$/);
 if (emailMatch) {
  from = emailMatch[1].trim();
  date = attribution.substring(0, attribution.length - emailMatch[0].length).replace(/[,;\s]+$/, "").trim();
 } else {
  var commaSplit = attribution.split(",");
  if (commaSplit.length > 1) {
   from = commaSplit[commaSplit.length - 1].trim();
   date = commaSplit.slice(0, commaSplit.length - 1).join(",").trim();
  }
 }
 return { from: from, date: date };
}

function splitForwardedThreadMessages_(forwardedRegion) {
 var text = String(forwardedRegion || "");
 var separators = collectForwardSeparators_(text);
 var messages = [];

 if (separators.length === 0) {
  var onlyBody = cleanForwardedBodyText_(text);
  if (onlyBody) messages.push({ from: "", date: "", subject: "", body: onlyBody });
  return messages;
 }

 for (var i = 0; i < separators.length; i++) {
  var separator = separators[i];
  var sliceEnd = (i + 1 < separators.length) ? separators[i + 1].index : text.length;
  var segment = text.substring(separator.index, sliceEnd);
  var message = { from: "", date: "", subject: "", body: "" };

  if (separator.kind === "inline") {
   var attribution = parseInlineQuoteAttribution_(separator.text);
   message.from = attribution.from;
   message.date = attribution.date;
   message.body = cleanForwardedBodyText_(segment.substring(separator.length));
  } else {
   var afterSeparator = separator.kind === "divider" ? segment.substring(separator.length) : segment;
   var parsedHeaders = parseForwardedHeaderBlock_(afterSeparator);
   message.from = parsedHeaders.headers.from;
   message.date = parsedHeaders.headers.date;
   message.subject = parsedHeaders.headers.subject;
   message.body = cleanForwardedBodyText_(parsedHeaders.bodyLines.join("\n"));
  }

  if (message.body || message.from) messages.push(message);
 }
 return messages;
}

// Newest message first, and it keeps the largest share of the character
// budget: on a long thread the open request is what has to survive intact.
function renderForwardedThread_(messages, maxChars) {
 if (messages.length <= 1) {
  return { text: messages.length ? messages[0].body.substring(0, maxChars) : "", omitted: 0, truncated: 0 };
 }

 var rendered = [];
 var remaining = maxChars;
 var omitted = 0;
 var truncated = 0;

 for (var i = 0; i < messages.length; i++) {
  var message = messages[i];
  var marker = "[" + (i + 1) + " of " + messages.length + (i === 0 ? " - NEWEST" : (i === messages.length - 1 ? " - oldest" : "")) + "]";
  var who = message.from ? " " + message.from : "";
  var when = message.date ? " | " + message.date : "";
  var header = marker + who + when + "\n";

  if (remaining < header.length + 120) { omitted++; continue; }

  var truncationMarker = "\n[... rest of this older message omitted ...]";
  var allowance = Math.min(
   (i === 0) ? Math.max(1500, Math.round(maxChars * 0.5)) : Math.max(300, Math.round(remaining * 0.6)),
   Math.max(120, remaining - header.length - truncationMarker.length)
  );
  var body = message.body;
  if (body.length > allowance) {
   body = body.substring(0, allowance).replace(/\s+\S*$/, "") + truncationMarker;
   truncated++;
  }
  rendered.push(header + body);
  remaining -= (header.length + body.length);
 }

 return { text: rendered.join("\n\n"), omitted: omitted, truncated: truncated };
}

function stripForwardNoteSignature_(note) {
 var lines = String(note || "").split("\n");
 var kept = [];
 for (var i = 0; i < lines.length; i++) {
  if (/^\s*(?:best\s+regards|kind\s+regards|warm\s+regards|regards|rgds|sincerely|cheers|thanks(?:\s+and\s+regards)?|thank\s+you|br)\b[\s,.!-]*$/i.test(lines[i])) break;
  kept.push(lines[i]);
 }
 return kept.join("\n")
  .replace(/^\s*(?:hi|hello|hey|dear|good\s+morning|good\s+afternoon|good\s+evening)\b[^\n]{0,40}[,:]?[ \t]*\n?/i, "")
  .trim();
}

// "none"     - nothing was written above the forward.
// "handoff"  - only a request to deal with it ("please help with this").
// "directed" - the forwarder added their own question or steer.
// Deliberately biased toward "directed": treating a hand-off as a steer is
// harmless, whereas discarding a real steer loses the instruction.
function classifyForwardNote_(note, senderName) {
 var raw = String(note || "").trim();
 if (!raw) return { type: "none", steer: "" };

 var meaningful = stripForwardNoteSignature_(raw);
 if (!meaningful) return { type: "handoff", steer: "" };

 var lower = meaningful.toLowerCase();
 if (/\d/.test(lower)) return { type: "directed", steer: meaningful };
 if (containsAnyText_(lower, FORWARD_TOPIC_HINT_TERMS_)) return { type: "directed", steer: meaningful };

 var reduced = " " + lower.replace(/[^a-z0-9\s]+/g, " ").replace(/\s+/g, " ").trim() + " ";
 var nameParts = String(senderName || "").toLowerCase().split(/\s+/);
 for (var n = 0; n < nameParts.length; n++) {
  if (nameParts[n].length > 2) reduced = reduced.split(" " + nameParts[n] + " ").join(" ");
 }
 var phrases = getForwardHandoffPhrases_();
 for (var p = 0; p < phrases.length; p++) {
  var phrase = " " + phrases[p] + " ";
  while (reduced.indexOf(phrase) >= 0) reduced = reduced.split(phrase).join(" ");
 }
 for (var f = 0; f < FORWARD_NOTE_FILLER_WORDS_.length; f++) {
  var filler = " " + FORWARD_NOTE_FILLER_WORDS_[f] + " ";
  while (reduced.indexOf(filler) >= 0) reduced = reduced.split(filler).join(" ");
 }
 reduced = reduced.replace(/\s+/g, " ").trim();

 return reduced.length >= 8
  ? { type: "directed", steer: meaningful }
  : { type: "handoff", steer: "" };
}


// ===========================================================================
// The two functions Code.gs calls
// ===========================================================================

/**
 * Called from extractLatestReplyText_ in Code.gs.
 * Returns the rebuilt context text when the email carries a forwarded or
 * quoted conversation, or null to leave the normal behaviour untouched.
 */
function getForwardedEmailContext_(rawBody) {
 LAST_FORWARD_CONTEXT_ = null;
 var text = String(rawBody || "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
 if (!text.trim()) return null;

 var boundary = findForwardBoundary_(text);
 // Nothing quoted in the body. Some clients strip the quoted history when
 // someone adds Ethan to an existing conversation, so fall back to reading
 // the earlier messages out of the Gmail conversation itself.
 if (!boundary) return buildGmailThreadHistoryContext_(text);

 var note = extractLatestReplyText_NATIVE_(text.substring(0, boundary.index)).trim();
 var messages = splitForwardedThreadMessages_(text.substring(boundary.index));
 if (messages.length === 0) return null;

 var newest = messages[0];
 // Table-fill requests often forward a long reference table; keep more of it
 // so the reference is not tail-truncated. General: only when a table is asked for.
 var fwdCap = senderWantsTable_("", rawBody) ? Math.max(FORWARD_MAX_CONTEXT_CHARS_, 16000) : FORWARD_MAX_CONTEXT_CHARS_;
 var thread = renderForwardedThread_(messages, fwdCap);
 if (!newest.from && thread.text.length < 20) return null;

 var noteClassification = classifyForwardNote_(note, "");
 var info = {
  kind: boundary.kind,
  note: note,
  noteType: noteClassification.type,
  noteSteer: noteClassification.steer,
  messageCount: messages.length,
  omittedMessages: thread.omitted,
  originalFrom: newest.from,
  originalFromName: extractForwardedSenderName_(newest.from),
  originalSubject: newest.subject,
  originalDate: newest.date,
  latestMessageBody: newest.body,
 };

 var label = boundary.kind === "forward" ? "FORWARDED EMAIL" : "EARLIER CONVERSATION QUOTED IN THIS EMAIL";
 var lines = [];
 lines.push("[MESSAGE WRITTEN BY THE PERSON YOU ARE REPLYING TO]");
 lines.push(note || "(Nothing was written above - passing the conversation on IS the request for help.)");
 lines.push("");
 lines.push("[" + label + (messages.length > 1 ? " - " + messages.length + " MESSAGES, NEWEST FIRST" : "") + "]");
 if (messages.length === 1) {
  if (info.originalFrom) lines.push("Written by: " + info.originalFrom);
  if (info.originalSubject) lines.push("Subject: " + info.originalSubject);
  if (info.originalDate) lines.push("Date: " + info.originalDate);
  lines.push("");
 }
 lines.push(thread.text || "(No readable text.)");

 info.contextText = lines.join("\n").trim();

 // Document search ranks keywords by how often a word appears, so it gets a
 // different version of the same content: message text only, with the sender
 // names, dates and labels removed, and the covering note plus the newest
 // message repeated. Otherwise the names and dates in a long history outrank
 // the actual question and the wrong documents get picked.
 var searchParts = [note, newest.body, newest.body];
 for (var s = 1; s < messages.length; s++) searchParts.push(messages[s].body);
 info.searchText = searchParts.join("\n\n").replace(/\n{3,}/g, "\n\n").trim();
 LAST_FORWARD_CONTEXT_ = info;
 return info.contextText;
}

/**
 * Called from callClaude in Code.gs. Returns the handling rules for the email
 * currently being processed, or "" when it is not a forwarded conversation.
 */
function getForwardedEmailInstructionForCurrentEmail_(sender, senderName) {
 var info = LAST_FORWARD_CONTEXT_;
 if (!info) return "";

 var recipient = getSafeGreetingName_(senderName) || "the person who sent you this email";
 var origin = info.originalFromName || info.originalFrom || "the original sender";
 var arrived = info.kind === "forward"
  ? "who forwarded this conversation to you"
  : (info.kind === "gmail-thread"
   ? "who brought you into an email conversation that was already running"
   : "who sent you this email with the earlier conversation quoted below it");

 var instruction = "\nFORWARDED / QUOTED CONVERSATION HANDLING:\n"
  + "- You are replying to " + recipient + " (" + extractEmailAddress(sender) + "), " + arrived + ". Greet ONLY " + recipient + ", using the Customer's name field exactly as given.\n"
  + "- The request you must satisfy is inside that conversation, not in the covering note. Answer the questions written there from the KNOWLEDGE BASE CONTEXT above.\n";

 if (info.noteType === "none") {
  instruction += "- " + recipient + " wrote no covering message at all. Passing the conversation on IS the request: work out what it is asking for and answer it in full. Do not reply asking what they need, and do not send a bare acknowledgement.\n";
 } else if (info.noteType === "handoff") {
  instruction += "- " + recipient + "'s covering note only hands the email over (wording such as \"please help with this\" or \"please refer to the forwarded email\"). It contains no question of its own, so do NOT answer it literally, do not restate it, and do not reply with an acknowledgement. Treat it as: answer everything the conversation is asking.\n";
 } else if (info.noteSteer) {
  instruction += "- " + recipient + " added their own instruction: \"" + String(info.noteSteer).replace(/"/g, "'").substring(0, 400) + "\". This is the HIGHEST-PRIORITY guide to which part of the conversation to deal with. Answer what they pointed you to first and in full; cover anything else only briefly, and leave out parts they did not ask about.\n";
 }

 if (info.messageCount > 1) {
  instruction += "- The conversation is a thread of " + info.messageCount + " messages, marked [1 of " + info.messageCount + "] to [" + info.messageCount + " of " + info.messageCount + "] and shown newest first, each with its sender and date. Use those dates to confirm the order.\n"
   + "- Read the whole thread for background, but ANSWER ONLY WHAT IS STILL OPEN in the newest message(s). Do not re-answer a question that was already answered later in the thread, and do not summarise the thread back to " + recipient + ".\n"
   + "- If the newest message was written by someone at x-phy.com or flexxon.com, the open request is the newest message from the other party.\n"
   + "- Where a question in the newest message depends on something agreed earlier in the thread (a capacity, a package, a quantity, a model), carry that detail forward instead of asking for it again.\n"
   + "- Older messages may be marked as omitted or shortened. Answer from what you have and never mention that anything was left out.\n";
 }

 instruction += "- Never greet, address, or write the reply as though it were being sent to " + origin + ". Never tell " + recipient + " to ask " + origin + " to contact us, and never ask for the email to be resent - you already have its full text above.\n"
  + "- Never say you have forwarded, escalated, shared, or passed the message on, and never promise that anyone will follow up.\n"
  + "- Never reply with SKIP_THIS_EMAIL when the conversation contains a question, even if the covering note is empty or says only \"please help\".\n"
  + "- Write the answer so " + recipient + " can read it directly and could pass it on themselves if they choose.\n"
  + "- Use ONLY the KNOWLEDGE BASE CONTEXT above. The conversation may come from an outside domain, but that does not change which information you may use - answer from the provided context exactly as you would for any other email.\n";
 return instruction;
}


var CURRENT_GMAIL_THREAD_ = null;
var CURRENT_GMAIL_MESSAGE_ID_ = "";

/**
 * Called once per email from processEmail so the functions below can reach the
 * Gmail conversation the message belongs to. Cleared for anything that is not
 * a live inbox run (the sheet preview and the self-test pass nothing).
 */
function setCurrentGmailThread_(thread, message) {
 CURRENT_GMAIL_THREAD_ = thread || null;
 CURRENT_GMAIL_MESSAGE_ID_ = "";
 if (message) {
  try { CURRENT_GMAIL_MESSAGE_ID_ = message.getId(); } catch (e) { }
 }
}

/**
 * Builds context from the earlier messages of the Gmail conversation. Used
 * only when the incoming message quoted nothing itself, which is what happens
 * when someone adds Ethan partway through an existing thread and their mail
 * client drops the quoted history. Returns null when there is no earlier
 * message, leaving ordinary one-off emails completely untouched.
 */
function buildGmailThreadHistoryContext_(currentText) {
 if (!CURRENT_GMAIL_THREAD_) return null;

 var earlier = [];
 try {
  var all = CURRENT_GMAIL_THREAD_.getMessages();
  for (var i = all.length - 1; i >= 0; i--) {
   var m = all[i];
   var id = "";
   try { id = m.getId(); } catch (e) { }
   if (id && id === CURRENT_GMAIL_MESSAGE_ID_) continue;
   var bodyText = "";
   try { bodyText = extractLatestReplyText_NATIVE_(m.getPlainBody() || ""); } catch (e2) { }
   if (!bodyText.trim()) continue;
   var from = ""; var when = "";
   try { from = m.getFrom() || ""; } catch (e3) { }
   try { when = Utilities.formatDate(m.getDate(), getScriptTimezone_(), "EEE, d MMM yyyy 'at' HH:mm"); } catch (e4) { }
   earlier.push({ from: from, date: when, subject: "", body: cleanForwardedBodyText_(bodyText) });
  }
 } catch (threadError) {
  log(" Could not read the Gmail conversation history: " + threadError.message);
  return null;
 }
 if (earlier.length === 0) return null;

 var note = extractLatestReplyText_NATIVE_(currentText).trim();
 var rendered = renderForwardedThread_(earlier, FORWARD_MAX_CONTEXT_CHARS_);
 var noteClassification = classifyForwardNote_(note, "");
 var newest = earlier[0];

 var info = {
  kind: "gmail-thread",
  note: note,
  noteType: noteClassification.type,
  noteSteer: noteClassification.steer,
  messageCount: earlier.length,
  omittedMessages: rendered.omitted,
  originalFrom: newest.from,
  originalFromName: extractForwardedSenderName_(newest.from),
  originalSubject: "",
  originalDate: newest.date,
  latestMessageBody: newest.body,
 };

 var lines = [];
 lines.push("[MESSAGE WRITTEN BY THE PERSON YOU ARE REPLYING TO]");
 lines.push(note || "(Nothing new was written - the conversation below IS the request for help.)");
 lines.push("");
 lines.push("[EARLIER MESSAGES IN THIS EMAIL CONVERSATION"
  + (earlier.length > 1 ? " - " + earlier.length + " MESSAGES, NEWEST FIRST" : "") + "]");
 lines.push("");
 lines.push(rendered.text);
 info.contextText = lines.join("\n").trim();

 var searchParts = [note, note];
 for (var s = 0; s < earlier.length; s++) searchParts.push(earlier[s].body);
 info.searchText = searchParts.join("\n\n").replace(/\n{3,}/g, "\n\n").trim();

 log(" Gmail conversation history used: " + earlier.length + " earlier message(s) read from the thread"
  + (rendered.omitted ? " (" + rendered.omitted + " dropped for length)" : ""));
 LAST_FORWARD_CONTEXT_ = info;
 return info.contextText;
}


/**
 * Called from processEmail in Code.gs to decide which text the spam and
 * "needs a human" checks should read.
 *
 * On a forwarded email it returns ONLY the covering note the forwarder wrote,
 * so angry wording or a quoted newsletter footer inside the FORWARDED message
 * cannot stop Ethan from answering. The reply only ever goes back to the
 * person who emailed Ethan, so an upset customer never receives an AI reply
 * either way, and that colleague can judge for themselves whether a case
 * needs a human before forwarding it.
 *
 * If the forwarder's OWN note says something like "this customer is furious",
 * that still escalates as normal. Ordinary, non-forwarded emails are checked
 * exactly as before.
 *
 * To go back to checking the whole forwarded conversation, change the line
 * below to: return fallbackText;
 */
function getEscalationCheckText_(fallbackText) {
 if (!LAST_FORWARD_CONTEXT_) return fallbackText;
 return LAST_FORWARD_CONTEXT_.note || "";
}


/**
 * Called from processEmail in Code.gs, where it replaces the body passed to
 * searchKnowledgeBase. Returns the search-optimised text for a forwarded
 * conversation, or the value passed in when the email is an ordinary one.
 */
function getForwardedSearchTextOrDefault_(fallbackText) {
 return (LAST_FORWARD_CONTEXT_ && LAST_FORWARD_CONTEXT_.searchText)
  ? LAST_FORWARD_CONTEXT_.searchText
  : fallbackText;
}


