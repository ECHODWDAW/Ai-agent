// SECTION 13 OF 20: KNOWLEDGE BASE SEARCH AND SCORING
// Find relevant KB files, add pricing/processor/general context, and score documents against email intent.
// ============================================================================

function searchKnowledgeBase(subject, body, classification) {
 classification = classification || classifyEmail_(subject, body);
 var emailText = (subject + " " + body).toLowerCase();

 // HARD SOURCE SWITCH: external mode reads ONLY the manual link sheet and
 // its curated blocks. The Drive crawl / inventory / internal curated paths
 // below are unreachable in external mode by construction.
 if (isExternalMode_()) {
  return buildExternalKnowledgeContext_(emailText, classification);
 }

 // A simple DFD overview must not inherit installation/specification content
 // merely because those documents contain strong DFD keyword matches.
 if (isPureProductOverviewQuery_(emailText, classification.productLine)) {
  log(" Pure " + classification.productLine + " overview detected; using curated overview context only");
  return {
   text: getProductOverviewContext_(classification.productLine),
   files: [],
   docsUsed: 1,
   filesUsed: "Curated " + classification.productLine + " Product Overview",
   classification: classification,
  };
 }

 // A multi-question email needs enough keywords to represent EVERY topic:
 // the default 8-word cap made later questions (e.g. Management Console,
 // Windows 11 bootable) invisible to document scoring, so their guides were
 // never retrieved and the reply deferred despite the docs existing.
 var isMultiQuestion = isMultiQuestionEmail_(subject + " " + body);
 var keywords = extractKeywords(subject + " " + body, isMultiQuestion ? 24 : 8);
 log(" Keywords: " + keywords.join(", "));

 var allFiles = getKnowledgeBaseIndex_();
 var lookupCount = allFiles.filter(function(file) { return file.sourceType === "kb_lookup_index"; }).length;
 log(" Indexed " + allFiles.length + " KB item(s), including " + lookupCount + " spreadsheet lookup row(s)");

 if (allFiles.length === 0) {
  return { text: "[No knowledge base documents found]", files: [], docsUsed: 0 };
 }

 var scoredFiles = [];
 var allowComparative = isComparisonQuery_(subject + " " + body);
 for (var i = 0; i < allFiles.length; i++) {
  if (isDisabledProductFile_(allFiles[i])) continue;
  if (!isSearchableKnowledgeFile_(allFiles[i])) continue;
  if (!allowComparative && isComparativeFile_(allFiles[i])) continue;
  var score = scoreKnowledgeFile_(allFiles[i], keywords, classification);
  scoredFiles.push({ file: allFiles[i], score: score });
 }

 var rankedFiles = scoredFiles
  .filter(function(f) { return f.score > 0; })
  .sort(function(a, b) { return b.score - a.score; });

 var searchCap = isMultiQuestion ? Math.max(CONFIG.MAX_FILES_TO_SEARCH, 8) : CONFIG.MAX_FILES_TO_SEARCH;
 // Coverage-aware selection: pure score ranking lets one dominant product
 // fill every slot in a multi-question email. Greedily prefer files that
 // cover keywords no already-chosen file covers, so each distinct topic
 // gets at least one document in the pool.
 var matchedFiles = selectKeywordCoveringFiles_(rankedFiles, keywords, searchCap);

 // Bootable/OS-installation questions must always carry their two source
 // guides in full, so Claude can pull extra context beyond the curated block.
 if (isBootableDriveQuery_(emailText)) {
  var bootableGuides = allFiles.filter(function(file) {
   if (isDisabledProductFile_(file) || !isSearchableKnowledgeFile_(file)) return false;
   var name = String(file.name || "").toLowerCase();
   if (name.indexOf("[service provider]") >= 0 || name.indexOf("[r]") === 0 || name.indexOf("outdated") >= 0) return false;
   return name.indexOf("bootable") >= 0
    || (name.indexOf("integration") >= 0 && name.indexOf("installation") >= 0);
  }).slice(0, 2);
  for (var bg = bootableGuides.length - 1; bg >= 0; bg--) {
   var alreadyIn = matchedFiles.some(function(f) { return f.id === bootableGuides[bg].id; });
   if (!alreadyIn) matchedFiles.unshift(bootableGuides[bg]);
  }
  if (bootableGuides.length) log(" Bootable query: pinned " + bootableGuides.length + " guide doc(s) to the front of extraction");
 }

 log(" Matched " + matchedFiles.length + " file(s) by classifier scoring (multi-question: " + isMultiQuestion + ")");

 if (matchedFiles.length === 0) {
  log(" No keyword matches falling back to FAQ, Pricelist, and DataSheet content");
  matchedFiles = allFiles
   .filter(function(file) {
    if (isDisabledProductFile_(file)) return false;
    var haystack = normalizeExclusionName_([file.name, file.category, file.path].join(" "));
    return containsAnyText_(haystack, ["faq", "pricelist", "price list", "datasheet", "data sheet"]);
   })
   .slice(0, CONFIG.MAX_FILES_TO_SEARCH);
 }

 if (matchedFiles.length === 0) {
  return { text: "[No matching knowledge base documents found]", files: [], docsUsed: 0 };
 }

 var aggregatedText = "";
 var docsUsed = 0;
 var extractCap = isMultiQuestion ? Math.max(CONFIG.MAX_FILES_TO_EXTRACT, 5) : CONFIG.MAX_FILES_TO_EXTRACT;
 var filesToExtract = matchedFiles.slice(0, extractCap);
 var fileNamesUsed = [];

 log(" Extracting top " + filesToExtract.length + " file(s) after classification scoring");
 for (var j = 0; j < filesToExtract.length; j++) {
  var fileMeta = filesToExtract[j];
  var content = "";
  try {
   content = extractFileContentByMetadata_(fileMeta);
  } catch (extractionError) {
   // A row pointing at a deleted, moved, or replaced Drive file must not
   // kill the whole run. Replacing a file in Drive creates a NEW file ID -
   // update the AI_KB / inventory row to the new ID to fix this permanently.
   log(" EXTRACTION FAILED for '" + fileMeta.name + "' (id: " + fileMeta.id + "): " + extractionError.message
    + " - skipping this file. Update its row in the AI_KB/inventory sheet to the current Drive file ID.");
   continue;
  }
  if (content && content.trim().length > 0) {
   aggregatedText += "\n=== Document: " + fileMeta.name + " ===\n"
    + "Original link: " + fileMeta.url + "\n"
    + content + "\n";
   docsUsed++;
   fileNamesUsed.push(fileMeta.name);
  }
 }

 if (classification.category === "Pricing" || isPricingQuery(keywords, emailText)) {
  var pricingData = getPricingData();
  if (pricingData.length > 0) {
   aggregatedText += pricingData;
   docsUsed++;
   fileNamesUsed.push("MASTER PRICELIST");
   log(" Pricing data appended to context");
  }
 }

 if (isProcessorCompatibilityQuery_(emailText)) {
  aggregatedText += getProcessorCompatibilityContext_();
  docsUsed++;
  fileNamesUsed.push("Processor Compatibility Chart");
  log("Processor compatibility chart appended to context");
 }

 if (isSsdCapacityQuery_(emailText)) {
  aggregatedText += getSsdCapacityContext_(emailText);
  docsUsed++;
  fileNamesUsed.push("SSD Capacity vs Stock Split");
  log("SSD capacity/stock split context appended to context");
 }

 if (isWipeDataVsRapidPurgeQuery_(emailText)) {
  aggregatedText += getWipeDataVsRapidPurgeContext_();
  docsUsed++;
  fileNamesUsed.push("Wipe Data vs Rapid Purge Technical Distinction");
  log("Wipe Data vs Rapid Purge context appended to context");
 }

 if (isGuardPackageSeriesQuery_(emailText) && !senderWantsTable_("", emailText)) {
  aggregatedText += getGuardPackageSeriesContext_(emailText);
  docsUsed++;
  fileNamesUsed.push("Guard Package Series Feature Matrix");
  log("Guard Package Series matrix appended to context");
 }
 if (isProtectionScopeQuery_(emailText)) {
  aggregatedText += getProtectionScopeContext_();
  docsUsed++;
  fileNamesUsed.push("Protection Scope Clarification");
  log("Protection scope context appended to context");
 }
 if (isDataSanitizationQuery_(emailText)) {
  aggregatedText += getDataSanitizationContext_();
  docsUsed++;
  fileNamesUsed.push("Data Sanitization Response Rules");
  log("Data sanitization context appended to context");
 }

 if (isBootableDriveQuery_(emailText)) {
  aggregatedText += getBootableDriveContext_();
  docsUsed++;
  fileNamesUsed.push("Windows 11 Bootable Drive Curated Context");
  log("Bootable drive curated context appended to context");
 }

 if (isGeneralDefinitionQuery_(emailText)) {
  aggregatedText += getGeneralExplanationContext_(emailText);
  docsUsed++;
  fileNamesUsed.push("General Product Explanation Glossary");
  log("General explanation glossary appended to context");
 }

 if (isAboutEthanQuery_(emailText)) {
  aggregatedText += getAboutEthanContext_();
  docsUsed++;
  fileNamesUsed.push("About Ethan Identity Answer");
  log("About-Ethan identity context appended to context");
 }

 // Ethan 1 (internal) is a strict superset of Ethan 2: on top of all the
 // internal knowledge above, also offer the approved EXTERNAL partner
 // reference links, so the internal agent never knows LESS than the external
 // one. The cached resolver keeps this near-free. Fail-open: a missing or
 // malformed external sheet must never break an internal reply.
 try {
  var partnerLinks = getExternalHelpfulLinks_(emailText);
  if (partnerLinks && partnerLinks.length > 0) {
   aggregatedText += "\n=== Additional approved reference documents (link only the relevant ones, as titled links - never paste the raw URL) ===\n";
   for (var pli = 0; pli < partnerLinks.length; pli++) {
    aggregatedText += "- " + partnerLinks[pli].title
     + (partnerLinks[pli].version ? " (" + partnerLinks[pli].version + ")" : "")
     + ": " + partnerLinks[pli].url + "\n";
   }
   docsUsed++;
   fileNamesUsed.push("External partner reference links (" + partnerLinks.length + ")");
   log("Internal mode: appended " + partnerLinks.length + " external partner reference link(s)");
  }
 } catch (extLinkError) {
  log(" Internal mode: could not append external partner links: " + extLinkError.message);
 }

 return {
  text: aggregatedText || "[Could not extract text from knowledge base documents]",
  files: matchedFiles,
  docsUsed: docsUsed,
  filesUsed: fileNamesUsed.join("; "),
  classification: classification,
 };
}

function buildKnowledgeFileHaystack_(fileMeta) {
 return normalizeProductPhrases_(String(fileMeta.name || "") + " " + String(fileMeta.category || "") + " " + String(fileMeta.productLine || "") + " " + String(fileMeta.topic || "") + " " + String(fileMeta.path || "") + " " + String(fileMeta.aiNotes || "") + " " + getFolderTextForFile_(fileMeta));
}

function selectKeywordCoveringFiles_(rankedScoredFiles, keywords, cap) {
 // Greedy max-coverage over the top-ranked candidates: always keep the best
 // file, then repeatedly add the file covering the most still-uncovered
 // keywords (ties resolved by score rank). Remaining slots fill by rank.
 var pool = rankedScoredFiles.slice(0, Math.max(cap * 6, 30));
 if (pool.length === 0) return [];

 var normalizedKeywords = (keywords || []).map(function(k) { return normalizeProductPhrases_(k); });
 var coverage = pool.map(function(entry) {
  var haystack = buildKnowledgeFileHaystack_(entry.file);
  var covered = {};
  for (var k = 0; k < normalizedKeywords.length; k++) {
   if (haystack.indexOf(normalizedKeywords[k]) >= 0) covered[k] = true;
  }
  return { entry: entry, covered: covered, picked: false };
 });

 var selected = [];
 var uncovered = {};
 for (var u = 0; u < normalizedKeywords.length; u++) uncovered[u] = true;

 var pick = function(index) {
  coverage[index].picked = true;
  selected.push(coverage[index].entry.file);
  for (var key in coverage[index].covered) delete uncovered[key];
 };

 pick(0);
 while (selected.length < cap) {
  var bestIndex = -1;
  var bestNewCount = 0;
  for (var i = 0; i < coverage.length; i++) {
   if (coverage[i].picked) continue;
   var newCount = 0;
   for (var c in coverage[i].covered) { if (uncovered[c]) newCount++; }
   if (newCount > bestNewCount) { bestNewCount = newCount; bestIndex = i; }
  }
  if (bestIndex < 0) break;
  pick(bestIndex);
 }
 // Fill any remaining slots with the next-best files by score.
 for (var j = 0; j < coverage.length && selected.length < cap; j++) {
  if (!coverage[j].picked) pick(j);
 }
 return selected;
}

function scoreKnowledgeFile_(fileMeta, keywords, classification) {
 var haystack = normalizeProductPhrases_(String(fileMeta.name || "") + " " + String(fileMeta.category || "") + " " + String(fileMeta.productLine || "") + " " + String(fileMeta.topic || "") + " " + String(fileMeta.path || "") + " " + String(fileMeta.aiNotes || "") + " " + getFolderTextForFile_(fileMeta));
 var score = 0;
 if (fileMeta.sourceType === "kb_lookup_index") score += getKnowledgeLookupBoost_(fileMeta);
 for (var k = 0; k < keywords.length; k++) {
  if (haystack.indexOf(normalizeProductPhrases_(keywords[k])) >= 0) score += 2;
 }

 if (classification && classification.productLine && classification.productLine !== "General X-PHY") {
  if (haystack.indexOf(normalizeProductPhrases_(classification.productLine)) >= 0) score += 12;
  for (var i = 0; i < (classification.strongTerms || []).length; i++) {
   if (haystack.indexOf(classification.strongTerms[i]) >= 0) score += 10;
  }
  for (var w = 0; w < (classification.weakTerms || []).length; w++) {
   if (haystack.indexOf(classification.weakTerms[w]) >= 0) score += 2;
  }
 }

 if (classification) {
  var category = classification.category;
  if (category === "Pricing" && containsAnyText_(haystack, ["price", "pricing", "pricelist", "quote"])) score += 15;
  if (category === "Installation" && containsAnyText_(haystack, ["install", "installation", "setup", "integration", "guide", "manual"])) score += 12;
  if (category === "Compatibility" && containsAnyText_(haystack, ["compatibility", "requirement", "processor", "cpu", "notebook"])) score += 12;
  if (category === "Technical Support" && containsAnyText_(haystack, ["support", "faq", "guide", "troubleshoot"])) score += 10;
  if (category === "Demo / Trial" && containsAnyText_(haystack, ["demo", "trial", "setup", "guide"])) score += 8;
 }

 if (containsAnyText_(haystack, ["faq", "datasheet", "data sheet", "user guide", "guide"])) score += 2;
 // FAQ/knowledgebase docs are the broadest single source for multi-part or
 // technical emails; make sure a product-matched FAQ can compete with narrow
 // guides and aiNotes-boosted rows. This haystack keeps punctuation, so the
 // dotted "f.a.q" spelling must be matched explicitly.
 if (containsAnyText_(haystack, ["faq", "f.a.q", "knowledgebase", "knowledge base"])) score += 8;
 if (fileMeta.priority) score += Math.max(0, 10 - Math.min(Number(fileMeta.priority), 100) / 10);
 return score;
}

function getKnowledgeLookupBoost_(fileMeta) {
 var aiNotes = String(fileMeta.aiNotes || "").trim();
 if (aiNotes.length >= 20) return 25;
 if (String(fileMeta.topic || "").trim() || String(fileMeta.linkLabel || "").trim()) return 12;
 return 4;
}

function isSearchableKnowledgeFile_(fileMeta) {
 if (fileMeta.sourceType === "kb_lookup_index") return true;
 var typeText = normalizeExclusionName_(String(fileMeta.inventoryType || "") + " " + String(fileMeta.mimeType || "") + " " + String(fileMeta.name || ""));
 if (typeText.indexOf("video") >= 0 || typeText.indexOf("mp4") >= 0 || typeText.indexOf("zip") >= 0 || typeText.indexOf("installer") >= 0) return false;
 if (fileMeta.mimeType === "application/octet-stream") return false;
 return true;
}

function isDisabledProductFile_(fileMeta) {
 if (CONFIG.SERVER_DEFENDER_ENABLED) return false;
 var haystack = normalizeProductPhrases_(String(fileMeta.name || "") + " " + String(fileMeta.category || "") + " " + String(fileMeta.productLine || "") + " " + String(fileMeta.path || "") + " " + getFolderTextForFile_(fileMeta));
 return haystack.indexOf("server_defender") >= 0;
}


