// ============================================================================
// SECTION 10 OF 20: REPLY OPTIONS, RECIPIENTS, AND MIME SENDERS
// Build Gmail reply options, support CC behavior, and optionally send threaded replies through the Gmail API.
// ============================================================================

function htmlToPlainText_(html) {
 // Gmail sends multipart messages: an empty text/plain part makes some clients
 // render a blank body even when the HTML part is fine. Always supply both.
 return String(html || "")
  .replace(/<style[\s\S]*?<\/style>/gi, "")
  .replace(/<br\s*\/?>/gi, "\n")
  .replace(/<\/(p|div|h[1-6]|tr|li)>/gi, "\n")
  .replace(/<li[^>]*>/gi, "- ")
  .replace(/<a [^>]*href="([^"]*)"[^>]*>([^<]*)<\/a>/gi, "$2 ($1)")
  .replace(/<\/td>\s*<td[^>]*>/gi, "  |  ")
  .replace(/<[^>]+>/g, "")
  .replace(/&nbsp;/gi, " ")
  .replace(/&amp;/gi, "&")
  .replace(/&lt;/gi, "<")
  .replace(/&gt;/gi, ">")
  .replace(/&quot;/gi, '"')
  .replace(/[ \t]{2,}/g, " ")
  .replace(/\s*\|\s*/g, "  |  ")
  .replace(/\n{3,}/g, "\n\n")
  .trim();
}

function buildReplyOptions_(emailHtml, images, ccRecipients, quoteSourceMessage) {
 // Last send-boundary guard. Every native Gmail reply/draft path passes through
 // this helper, including acknowledgements and special-product replies.
 emailHtml = removeDisabledSalesLearnMoreLeadIn_(emailHtml);
 // Quote the message being replied to, below the sign-off. Sending through the
 // API does not do this automatically the way clicking Reply in Gmail does, so
 // without it the reply arrives with no conversation attached to it. Added
 // AFTER the content scrubbers above so the quoted text is never rewritten.
 emailHtml = appendQuotedOriginalToReply_(emailHtml, quoteSourceMessage);
 var replyOptions = {
  htmlBody: emailHtml,
  body: htmlToPlainText_(emailHtml), // plain-text alternative so no client shows a blank body
 };
 var filteredCc = CONFIG.ENABLE_CC_SUPPORT ? filterCcRecipients_(ccRecipients) : [];
 var inlineImages = {};

 if (filteredCc.length > 0) {
  replyOptions.cc = filteredCc.join(",");
  log("CC after filtering: " + replyOptions.cc);
 }

 if (images && images.length > 0) {
  for (var i = 0; i < Math.min(images.length, CONFIG.MAX_INLINE_DOC_IMAGES); i++) {
   inlineImages["kb_image_" + i] = images[i];
  }
 }

 var swiftBanner = getSwiftBannerImage_();
 if (swiftBanner) inlineImages.swift_banner = swiftBanner;
 if (Object.keys(inlineImages).length > 0) replyOptions.inlineImages = inlineImages;

 return replyOptions;
}

// ============================================================================
// QUOTED HISTORY
// Gmail appends the message you are replying to when you click Reply in the
// web UI, but a reply sent through GmailApp contains only the body supplied.
// These helpers rebuild that quoted block so Ethan's replies carry the
// conversation with them - and stay readable when forwarded on to someone
// who was not part of the original thread.
// ============================================================================

function appendQuotedOriginalToReply_(emailHtml, message) {
 if (CONFIG.INCLUDE_QUOTED_HISTORY_IN_REPLY === false) return emailHtml;
 if (!message) return emailHtml;
 try {
  var quoted = buildQuotedOriginalHtml_(message);
  if (!quoted) return emailHtml;
  return String(emailHtml || "") + quoted;
 } catch (e) {
  // A reply that cannot be quoted must still go out.
  log(" Could not attach the quoted original to the reply: " + e.message);
  return emailHtml;
 }
}

function buildQuotedOriginalHtml_(message) {
 var originalHtml = "";
 try { originalHtml = message.getBody() || ""; } catch (e) { }
 if (!String(originalHtml).trim()) {
  var plain = "";
  try { plain = message.getPlainBody() || ""; } catch (e2) { }
  if (!plain.trim()) return "";
  originalHtml = escapeHtml_(plain).replace(/\r\n|\r|\n/g, "<br>");
 }
 originalHtml = sanitizeQuotedOriginalHtml_(originalHtml);
 if (!originalHtml) return "";

 var attribution = buildQuotedAttributionLine_(message);
 return '<br><div class="gmail_quote">'
  + '<div dir="ltr" class="gmail_attr" style="font-family:Arial,sans-serif;font-size:13px;color:#5f6368;">'
  + attribution + '<br></div>'
  + '<blockquote class="gmail_quote" style="margin:0 0 0 .8ex;border-left:1px solid #ccc;padding-left:1ex;">'
  + originalHtml
  + '</blockquote></div>';
}

function buildQuotedAttributionLine_(message) {
 var who = "";
 try { who = message.getFrom() || ""; } catch (e) { }
 var when = "";
 try {
  when = Utilities.formatDate(message.getDate(), getScriptTimezone_(), "EEE, d MMM yyyy 'at' HH:mm");
 } catch (e2) { }
 if (when && who) return "On " + escapeHtml_(when) + ", " + escapeHtml_(who) + " wrote:";
 if (who) return "On " + escapeHtml_(who) + " wrote:";
 return "Previous message:";
}

function sanitizeQuotedOriginalHtml_(html) {
 var cleaned = String(html || "")
  .replace(/<!doctype[^>]*>/gi, "")
  .replace(/<head\b[^>]*>[\s\S]*?<\/head>/gi, "")
  .replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, "")
  .replace(/<style\b[^>]*>[\s\S]*?<\/style>/gi, "")
  .replace(/<\/?(?:html|body|base|meta|link)\b[^>]*>/gi, "")
  // Inline images referenced by Content-ID are not carried over, so they
  // would render as broken placeholders in the quote.
  .replace(/<img\b[^>]*src\s*=\s*["']cid:[^"']*["'][^>]*>/gi, "")
  .trim();
 var cap = CONFIG.MAX_QUOTED_HISTORY_CHARS || 80000;
 if (cleaned.length > cap) {
  cleaned = cleaned.substring(0, cap) + "<br><i>[earlier part of this conversation not shown]</i>";
  log(" Quoted history trimmed to the " + cap + "-character cap.");
 }
 return cleaned;
}

