 if (/^mailto:/i.test(raw)) return "mailto";
 var driveId = extractDriveIdFromUrl_(raw);
 if (driveId) return "drive:" + driveId;
 var match = raw.match(/^https?:\/\/([^\/?#]+)([^?#]*)/i);
