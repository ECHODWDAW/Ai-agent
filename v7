var APPROVED_LINKS_FOR_REPLY_ = null;

// Public destinations that are safe for either audience.
var ALWAYS_ALLOWED_LINK_HOSTS_ = [
 "x-phy.com", "estore.x-phy.com", "platform.x-phy.com",
 "youtube.com", "youtu.be", "microsoft.com",
];

function getLinkHost_(url) {
 var match = String(url || "").match(/^https?:\/\/([^\/?#]+)/i);
 return match ? match[1].toLowerCase().replace(/^www\./, "") : "";
}

function isAlwaysAllowedLink_(url) {
 if (/^mailto:/i.test(String(url || ""))) return true;
 var host = getLinkHost_(url);
 if (!host) return false;
 for (var i = 0; i < ALWAYS_ALLOWED_LINK_HOSTS_.length; i++) {
  var allowed = ALWAYS_ALLOWED_LINK_HOSTS_[i];
  // Exact host, or a true subdomain. "x-phy.com.evil.co" must NOT pass.
  if (host === allowed) return true;
  if (host.length > allowed.length
   && host.substring(host.length - allowed.length - 1) === "." + allowed) return true;
 }
