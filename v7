// Two URLs point at the same document when they resolve to the same Drive file
// id, or to the same host and path. Drive links differ only by ?usp=drive_link
// versus ?usp=drivesdk, which must not defeat the match.
function normalizeLinkKey_(url) {
 var raw = String(url || "").trim().replace(/[.,;:)\]]+$/, "");
