// ============================================================================
// SECTION 5 OF 20: MAIN EMAIL PROCESSING PIPELINE
// Entry point and per-email orchestration: classify, search knowledge, generate/send reply, and log outcome.
// ============================================================================

// ===== DUAL-AGENT MODE (Option B: one codebase, two entry points) =====
// AGENT_MODE_ is set by the trigger entry point below and read everywhere
// else. Set your TWO time triggers on processNewEmailsInternal and
// processNewEmailsExternal - NOT on processNewEmails directly (running
// processNewEmails by hand defaults safely to INTERNAL).
var AGENT_MODE_ = "INTERNAL";
var INTERNAL_EMAIL_DOMAINS_ = {
 "x-phy.com": true,
 "flexxon.com": true,
};
function processNewEmailsInternal() { AGENT_MODE_ = "INTERNAL"; processNewEmails(); }
function processNewEmailsExternal() { AGENT_MODE_ = "EXTERNAL"; processNewEmails(); }
function isExternalMode_() { return AGENT_MODE_ === "EXTERNAL"; }

function processNewEmails() {
 log("BUILD 2026-07-23-FULL7 (channel-aware bulk/distributor acknowledgement) running from: " + ScriptApp.getScriptId() + " as " + Session.getEffectiveUser().getEmail());
 var lock = LockService.getScriptLock();
 if (!lock.tryLock(5000)) {
  log(" Another agent run is already in progress; skipping this trigger.");
  return;
 }

 var startTime = new Date();
 log(" Agent run started");

 try {
  validateConfig_();
  cleanupOldTempFiles_();
  ensureLabelExists(CONFIG.PROCESSED_LABEL);
 ensureLabelExists(CONFIG.HOLD_LABEL_NAME);
  var threads = getUnprocessedThreads();
  if (threads.length === 0) {
   log(" No new emails to process");
   return;
  }

  warmKnowledgeBaseCache_();
  log(" Found " + threads.length + " unprocessed email(s)");
  var processCount = Math.min(threads.length, CONFIG.MAX_EMAILS_PER_RUN);

  for (var i = 0; i < processCount; i++) {
   var thread = threads[i];
   var message = thread.getMessages()[thread.getMessageCount() - 1];

   try {
    processEmail(thread, message);
    // Cost firewall: remember the conversation state we just handled.
    // Fresh count includes our own reply when one was sent; capped at
    // start+1 so a customer message racing in is never masked.
    try {
     var freshCount = GmailApp.getThreadById(thread.getId()).getMessageCount();
     setThreadState_(thread.getId(), Math.min(freshCount, thread.getMessageCount() + 1), 0);
    } catch (stateErr) {
     setThreadState_(thread.getId(), thread.getMessageCount(), 0);
    }
   } catch (emailError) {
    log(' Error processing email "' + message.getSubject() + '": ' + emailError.message);
    notifyFailure_("Email processing failed", emailError, {
     sender: message.getFrom(),
     subject: message.getSubject(),
    });
    logToSheet({
     timestamp: new Date(),
     sender: message.getFrom(),
     subject: message.getSubject(),
     status: "ERROR",
     error: emailError.message,
     reply: "",
     docsUsed: "",
    });
   }
  }

  if (new Date().getMinutes() === 0) cleanupThreadStates_(); // prune once an hour
  var elapsed = ((new Date() - startTime) / 1000).toFixed(1);
  log(" Agent run complete processed " + processCount + " email(s) in " + elapsed + "s");

 } catch (error) {
  log(" Critical error: " + error.message);
  notifyFailure_("Critical AI email agent failure", error, {});
 } finally {
  lock.releaseLock();
 }
}


function processEmail(thread, message) {
 var sender = message.getFrom();
 var senderName = extractSenderName(sender);
 var subject = message.getSubject();
 var body = extractPlainText(message);

 // SAFETY NET: never auto-reply to portal / Level-2 support mail. Checked on the
 // ORIGINAL subject (before any portal parsing rewrites it) and on the thread,
 // so replies inside an existing portal thread are also left alone.
 if (isPortalOrLevel2Mail_(thread, subject)) {
  thread.markRead();
  applyLabel(thread, CONFIG.PROCESSED_LABEL);
  log(" SKIPPED_PORTAL_L2: portal / Level-2 support mail - Level-1 auto-reply suppressed. Subject: " + subject);
  logToSheet({
   timestamp: new Date(), sender: sender, subject: subject, status: "SKIPPED", error: "",
   reply: "Portal / Level-2 support mail - Level-1 auto-reply suppressed (safety net)",
   docsUsed: 0, category: "", productLine: "", filesUsed: "", claudeModel: "", escalationReason: "",
  });
  return;
 }

 // Copied in, not asked: if none of Ethan's own addresses is on the To line
 // he is only being kept in the loop, so he stays quiet. Checked here, before
 // classification and before any Claude call, so a Cc costs nothing. The
 // thread is left completely untouched - no label, no markRead - so if the
 // conversation later addresses him directly he picks it up on the next run.
 if (!isEthanDirectlyAddressed_(message)) {
  log(" SKIPPED_CC_ONLY: Ethan is only copied on this email, not addressed. To: "
   + (function () { try { return message.getTo() || "(empty)"; } catch (e) { return "(unreadable)"; } })()
   + ' | Subject: "' + subject + '"');
  return;
 }

 // Product Internal Portal: lift the real requester + question out of the
 // fixed template so the rest of the pipeline treats it as an ordinary
 // support question from that person.
 var portal = parsePortalRequest_(sender, body);
 if (portal.isPortal) {
  senderName = portal.submitterName;
  if (portal.subject) subject = portal.subject;
  if (portal.body) { body = portal.body; }
  else { log(" WARNING: portal Details field could not be parsed; using full body."); }
  log(' Product Internal Portal request: submitter="' + portal.submittedByRaw + '" | subject="' + subject + '" | detailsChars=' + (portal.body ? portal.body.length : 0));
 }

 // Must be set BEFORE the body is read: extractLatestReplyText_ uses it to
 // reach the earlier messages of this conversation, and a value left over
 // from the previous email in the run would attach the wrong history.
 setCurrentGmailThread_(thread, message);
 var latestBody = extractLatestReplyText_(body);
 var toRecipients = message.getTo();
 var ccRecipients = CONFIG.ENABLE_CC_SUPPORT ? message.getCc() : "";

 log(' Processing: "' + subject + '" from ' + sender + " (name: " + senderName + ")");

 // AUDIENCE GATE (fail-closed backstop behind the query filters). A thread
 // belonging to the other agent is left completely untouched - no label, no
 // markRead - so the correct mode's next run still picks it up cleanly.
 // Portal emails always arrive from admin_ai@x-phy.com (internal) and only the
 // internal agent ever fetches them, so never skip them on the audience gate.
 var senderIsInternal = isXphyInternalSender_(sender);
 if (!portal.isPortal && (isExternalMode_() ? senderIsInternal : !senderIsInternal)) {
  log(" SKIPPED_WRONG_AUDIENCE: " + sender + " belongs to the " + (isExternalMode_() ? "internal" : "external") + " agent; leaving thread untouched");
  return;
 }

 if (latestBody.length < body.length) {
  log(" Trimmed quoted thread history from " + body.length + " to " + latestBody.length + " characters for intent detection");
 }

 // On a forwarded email this is the covering note only - see Forwarding.gs.
 var escalationCheckText = getEscalationCheckText_(latestBody);
 var classification = classifyEmail_(subject, latestBody, { gateText: escalationCheckText });
 log(" Classification: " + classification.category + " / " + classification.productLine + " (confidence " + classification.confidence + ") - " + classification.reason);

 if (isProductTemporarilyDisabled_(classification.productLine)) {
  sendTemporarilyUnavailableProductReply_(thread, message, sender, senderName, subject, latestBody, toRecipients, ccRecipients, classification);
  return;
 }

 if (classification.shouldSkip) {
  thread.markRead();
  applyLabel(thread, CONFIG.PROCESSED_LABEL);
  logToSheet({
   timestamp: new Date(),
   sender: sender,
   subject: subject,
   status: "SKIPPED",
   error: "",
   reply: "Skipped by pre-classifier: " + classification.reason,
   docsUsed: 0,
   category: classification.category,
   productLine: classification.productLine,
   filesUsed: "",
   claudeModel: "",
   escalationReason: "",
  });
  return;
 }

 var bulkPricing = isBulkPricingInquiry_(subject, latestBody);
 var bulkPricingOnly = bulkPricing && !hasNonPricingQuestions_(subject, latestBody);
 if (bulkPricing && !bulkPricingOnly) {
  // Mixed email: the pricing request still goes to sales, but Claude answers
  // the customer's other questions. The Guard-series curated context already
  // instructs the reply to keep pricing in its own forwarded-to-sales paragraph.
  forwardToHuman_(message, "Bulk/volume pricing request inside a mixed email - other questions answered by AI");
  log(" Mixed bulk-pricing email: pricing forwarded to sales; continuing to Claude for the remaining questions");
 }
 if (classification.shouldEscalate || needsHumanEscalation_(subject, escalationCheckText) || bulkPricingOnly) {
  var escalationReason = classification.escalationReason || "Sentiment / risk escalation";
  if (!classification.escalationReason && bulkPricingOnly) {
   escalationReason = "Bulk/volume/reseller pricing inquiry - not in AI knowledge base";
  }
  forwardToHuman_(message, escalationReason);

  // Bulk-only inquiries get a tailored sales acknowledgement (product and
  // quantity echoed back) instead of the generic escalation wording - the
  // canned generic ack read jarringly next to the richer replies Claude
  // writes for mixed emails. Sentiment/risk escalations keep the generic ack.
  var useBulkAck = bulkPricingOnly && !classification.shouldEscalate && !needsHumanEscalation_(subject, escalationCheckText);
  var ackReply = useBulkAck
   ? buildBulkPricingAcknowledgementReply_(senderName, subject, latestBody)
   : buildEscalationAcknowledgementReply_(senderName);
  var ackReplyOptions = buildReplyOptions_(ackReply, [], ccRecipients, message);
  var ackRecipientLists = buildUnifiedReplyRecipientLists_(sender, toRecipients, ccRecipients);
  var ackStatus = "ESCALATED";

  try {
   if (CONFIG.ENABLE_AUTO_REPLY) {
    if (shouldUseNativeReplyAll_()) {
     thread.replyAll(ackReplyOptions.body || htmlToPlainText_(ackReply), ackReplyOptions);
    } else if (CONFIG.ENABLE_UNIFIED_GMAIL_API_SEND) {
     sendUnifiedThreadReply_(thread, message, subject, ackReply, [], ackRecipientLists);
    } else {
     message.reply(ackReplyOptions.body || htmlToPlainText_(ackReply), ackReplyOptions);
    }
    ackStatus = "ESCALATED_WITH_ACK";
   } else {
    if (shouldUseNativeReplyAll_()) {
     thread.createDraftReplyAll(ackReplyOptions.body || htmlToPlainText_(ackReply), ackReplyOptions);
    } else {
     GmailApp.createDraft(ackRecipientLists.to.join(","), makeReplySubject_(subject), ackReplyOptions.body || htmlToPlainText_(ackReply), ackReplyOptions);
    }
    ackStatus = "ESCALATED_DRAFT_ACK";
   }
  } catch (ackError) {
   log(" Could not send escalation acknowledgement: " + ackError.message);
   ackStatus = "ESCALATED_ACK_FAILED";
  }

  thread.markRead();
  applyLabel(thread, CONFIG.PROCESSED_LABEL);
  logToSheet({
   timestamp: new Date(),
   sender: sender,
   subject: subject,
   status: ackStatus,
   error: "",
   reply: "Forwarded to human support: " + escalationReason,
   docsUsed: 0,
   category: classification.category,
   productLine: classification.productLine,
   filesUsed: "",
   claudeModel: "",
   escalationReason: escalationReason,
  });
  return;
 }

 try {
  var knowledgeContext = searchKnowledgeBase(subject, getForwardedSearchTextOrDefault_(latestBody), classification);
  var matchedFiles = knowledgeContext.files || [];
  log(" Found " + knowledgeContext.docsUsed + " relevant document(s)");

  var weakKnowledgeContext = !isKnowledgeContextStrongEnough_(knowledgeContext, classification, subject, latestBody);
  // Keep live replies on the same generation path used by EMAIL_TEST_PREVIEW.
  var aiReply = callClaude(sender, senderName, subject, latestBody, knowledgeContext.text);

  if (aiReply.trim() === "SKIP_THIS_EMAIL") {
   log(" Skipping not a product query");
   thread.markRead();
   applyLabel(thread, CONFIG.PROCESSED_LABEL);
   logToSheet({
    timestamp: new Date(),
    sender: sender,
    subject: subject,
    status: "SKIPPED",
    error: "",
    reply: "Not a product query",
    docsUsed: knowledgeContext.docsUsed,
    category: classification.category,
    productLine: classification.productLine,
    filesUsed: knowledgeContext.filesUsed || "",
    claudeModel: LAST_CLAUDE_MODEL_USED_,
    escalationReason: "",
   });
   return;
  }

  if (shouldEscalateReply_(aiReply)) {
   classification.escalationReason = "AI said the query was forwarded to the internal team";
   forwardToHuman_(message, classification.escalationReason);
  }

  if (replyBodyLooksEmpty_(aiReply)) {
   log(" Reply body looks empty after stripping greeting/sign-off - falling back to escalation acknowledgement");
   classification.escalationReason = "AI produced no substantive answer";
   forwardToHuman_(message, classification.escalationReason);

   var emptyAckReply = buildEscalationAcknowledgementReply_(senderName);
   var emptyAckReplyOptions = buildReplyOptions_(emptyAckReply, [], ccRecipients, message);
   var emptyAckRecipientLists = buildUnifiedReplyRecipientLists_(sender, toRecipients, ccRecipients);
   var emptyAckStatus = "ESCALATED";

   try {
    if (CONFIG.ENABLE_AUTO_REPLY) {
     if (shouldUseNativeReplyAll_()) {
      thread.replyAll(emptyAckReplyOptions.body || htmlToPlainText_(emptyAckReply), emptyAckReplyOptions);
     } else if (CONFIG.ENABLE_UNIFIED_GMAIL_API_SEND) {
      sendUnifiedThreadReply_(thread, message, subject, emptyAckReply, [], emptyAckRecipientLists);
     } else {
      message.reply(emptyAckReplyOptions.body || htmlToPlainText_(emptyAckReply), emptyAckReplyOptions);
     }
     emptyAckStatus = "ESCALATED_WITH_ACK";
    } else {
     if (shouldUseNativeReplyAll_()) {
      thread.createDraftReplyAll(emptyAckReplyOptions.body || htmlToPlainText_(emptyAckReply), emptyAckReplyOptions);
     } else {
      GmailApp.createDraft(emptyAckRecipientLists.to.join(","), makeReplySubject_(subject), emptyAckReplyOptions.body || htmlToPlainText_(emptyAckReply), emptyAckReplyOptions);
     }
     emptyAckStatus = "ESCALATED_DRAFT_ACK";
    }
   } catch (emptyAckError) {
    log(" Could not send escalation acknowledgement: " + emptyAckError.message);
    emptyAckStatus = "ESCALATED_ACK_FAILED";
   }

   thread.markRead();
   applyLabel(thread, CONFIG.PROCESSED_LABEL);
   logToSheet({
    timestamp: new Date(),
    sender: sender,
    subject: subject,
    status: emptyAckStatus,
    error: "",
    reply: "Forwarded to human support: " + classification.escalationReason,
    docsUsed: knowledgeContext.docsUsed,
    category: classification.category,
    productLine: classification.productLine,
    filesUsed: knowledgeContext.filesUsed || "",
    claudeModel: LAST_CLAUDE_MODEL_USED_,
    escalationReason: classification.escalationReason,
   });
   return;
  }

  var docImages = (weakKnowledgeContext && CONFIG.DISABLE_IMAGES_WHEN_CONTEXT_IS_WEAK)
   ? []
   : collectInlineImagesForCustomerNeed_(subject, latestBody, matchedFiles);
  var emailHtml = buildEmailHtmlWithImages_(aiReply, docImages, subject, latestBody);
  var replyOptions = buildReplyOptions_(emailHtml, docImages, ccRecipients, message);
  var recipientLists = buildUnifiedReplyRecipientLists_(sender, toRecipients, ccRecipients);
  logPreSendBodyDiagnostics_(aiReply, emailHtml, replyOptions.body, docImages);

  var status;
  if (CONFIG.ENABLE_AUTO_REPLY) {
   if (shouldUseNativeReplyAll_()) {
    try {
     thread.replyAll(replyOptions.body || htmlToPlainText_(emailHtml), replyOptions);
    } catch (replyAllError) {
     log(" Native replyAll failed; falling back to configured send path: " + replyAllError.message);
     if (CONFIG.ENABLE_UNIFIED_GMAIL_API_SEND) {
      sendUnifiedThreadReply_(thread, message, subject, emailHtml, docImages, recipientLists);
     } else {
      message.reply(replyOptions.body || htmlToPlainText_(emailHtml), replyOptions);
     }
    }
   } else if (CONFIG.ENABLE_UNIFIED_GMAIL_API_SEND) {
    sendUnifiedThreadReply_(thread, message, subject, emailHtml, docImages, recipientLists);
   } else {
    message.reply(replyOptions.body || htmlToPlainText_(emailHtml), replyOptions);
   }
   status = "SENT";
   log(" Reply sent to " + recipientLists.to.join(", ") + " with " + Math.min(docImages.length, CONFIG.MAX_INLINE_DOC_IMAGES) + " inline image(s)");
  } else {
   if (shouldUseNativeReplyAll_()) {
    thread.createDraftReplyAll(replyOptions.body || htmlToPlainText_(emailHtml), replyOptions);
   } else {
    GmailApp.createDraft(recipientLists.to.join(","), makeReplySubject_(subject), replyOptions.body || htmlToPlainText_(emailHtml), replyOptions);
   }
   status = "DRAFT";
   log(" Auto-reply is OFF; draft created for " + recipientLists.to.join(", ") + " with " + Math.min(docImages.length, CONFIG.MAX_INLINE_DOC_IMAGES) + " inline image(s)");
  }

  thread.markRead();
  applyLabel(thread, CONFIG.PROCESSED_LABEL);

  logToSheet({
   timestamp: new Date(),
   sender: sender,
   subject: subject,
   status: status,
   error: "",
   reply: aiReply.substring(0, 500),
   docsUsed: knowledgeContext.docsUsed,
   category: classification.category,
   productLine: classification.productLine,
   filesUsed: knowledgeContext.filesUsed || "",
   claudeModel: LAST_CLAUDE_MODEL_USED_,
   escalationReason: classification.escalationReason || "",
  });

 } catch (error) {
  log(" Processing failed: " + error.message);
  if (error && error.stack) log(" Stack: " + error.stack);
  var tid = thread.getId();
  var startCount = thread.getMessageCount();
  var prev = getThreadState_(tid);
  var attempts = ((prev && prev.attempts) || 0) + 1;
  if (attempts >= MAX_PROCESSING_ATTEMPTS_) {
   // Retry cap reached: quarantine this conversation state so it cannot
   // burn another model call until the customer sends a new message.
   log(" Retry cap (" + MAX_PROCESSING_ATTEMPTS_ + ") reached; quarantining thread and alerting support.");
   setThreadState_(tid, startCount, attempts);
   try {
    applyLabel(thread, CONFIG.PROCESSED_LABEL);
    thread.markRead();
   } catch (labelErr) {}
   notifyFailure_("Email quarantined after " + attempts + " failed attempts", error, {
    sender: message.getFrom(),
    subject: message.getSubject(),
   });
  } else {
   // Record the failed attempt but keep the stored count below the live
   // count so the filter allows one more retry next cycle.
   setThreadState_(tid, startCount - 1, attempts);
   thread.markUnread();
  }
  throw error;
 }
}


