 if (containsAnyText_(t, ["guide", "manual", "installation", "bootable", "partition"])) return "Guides";
 return "";
}

function getExternalDriveFileMetadata_(url) {
 var fileId = extractDriveIdFromUrl_(url);
 if (!fileId) return null;
 try {
  var file = DriveApp.getFileById(fileId);
  var parentNames = [];
  var pendingFolders = [];
  var directParents = file.getParents();
  while (directParents.hasNext()) pendingFolders.push(directParents.next());
  var seenFolders = {};
  var inspectedFolders = 0;
  while (pendingFolders.length > 0 && inspectedFolders < 50) {
   var folder = pendingFolders.shift();
   var folderId = folder.getId();
   if (seenFolders[folderId]) continue;
   seenFolders[folderId] = true;
   inspectedFolders++;
   parentNames.push(folder.getName());
   var ancestors = folder.getParents();
   while (ancestors.hasNext()) pendingFolders.push(ancestors.next());
  }
  return { id: fileId, title: file.getName(), parentNames: parentNames };
 } catch (e) {
  log("External partner link skipped because Drive metadata could not be read: " + url + " | " + e.message);
  return null;
 }
}

function isRestrictedExternalMetadata_(metadata) {
 if (!metadata) return false;
 if (hasRestrictedMarker_(metadata.title)) return true;
 var parentNames = metadata.parentNames || [];
 for (var i = 0; i < parentNames.length; i++) {
  if (hasRestrictedMarker_(parentNames[i])) return true;
 }
 return false;
}

function scoreExternalKnowledgeRow_(emailText, category, title, notes) {
 var text = String(emailText || "").toLowerCase();
 var titleText = String(title || "").toLowerCase().replace(/[_-]+/g, " ");
 var categoryKeywords = EXTERNAL_CATEGORY_KEYWORDS_[category] || [];
 var rule = getExternalDocumentRule_(title);
 var categoryMatched = containsAnyText_(text, categoryKeywords);
 var documentMatched = rule ? containsAnyText_(text, rule.queryTerms) : false;
 var isDeepfakeQuestion = containsAnyText_(text, ["deepfake", "dfd", "synthetic", "faceswap", "lipsync"]);
 var isDeepfakeDocument = titleText.indexOf("deepfake") >= 0;
 var isAndroidQuestion = text.indexOf("android") >= 0;
 var isIosQuestion = containsAnyText_(text, ["ios", "iphone", "ipad"]);

 // Product isolation inside the shared Guides category.
 if (isDeepfakeQuestion && category === "Guides" && !isDeepfakeDocument) return 0;
 if (isAndroidQuestion && titleText.indexOf("ios") >= 0) return 0;
 if (isIosQuestion && titleText.indexOf("android") >= 0) return 0;

 // A document-specific rule is a relevance gate. This stops a broad word such
 // as "setup" from returning every guide, including unrelated product guides.
 if (rule && !documentMatched) return 0;
 if (!rule && !categoryMatched) return 0;

 var score = categoryMatched ? 20 : 0;
 if (documentMatched) score += 60;

 var searchableRowText = (String(title || "") + " " + String(notes || "")).toLowerCase().replace(/[_-]+/g, " ");
 var queryTokens = text.split(/[^a-z0-9]+/).filter(function(token) { return token.length >= 4; });
 for (var i = 0; i < queryTokens.length; i++) {
  if (searchableRowText.indexOf(queryTokens[i]) >= 0) score += 3;
 }
 return score;
}

var EXTERNAL_PARTNER_LINKS_CACHE_ = null;
var EXTERNAL_PARTNER_LINKS_CACHE_KEY_ = "EXT_PARTNER_LINKS_RESOLVED_V1";
var EXTERNAL_PARTNER_LINKS_TTL_SECONDS_ = 6 * 60 * 60;

// Resolve every EXTERNAL PARTNER DB link's Drive metadata ONCE and cache it.
// Uncached, each call hit Drive (getFileById + a parent-folder walk) for every
// link on EVERY email. Both agents now share this cache: Ethan 2 natively, and
// Ethan 1 as an add-on layer, so adding the partner links to internal is
// near-free after the first resolve.
function getResolvedExternalPartnerLinks_() {
 if (EXTERNAL_PARTNER_LINKS_CACHE_) return EXTERNAL_PARTNER_LINKS_CACHE_;
 try {
  var hit = CacheService.getScriptCache().get(EXTERNAL_PARTNER_LINKS_CACHE_KEY_);
  if (hit) { EXTERNAL_PARTNER_LINKS_CACHE_ = JSON.parse(hit); return EXTERNAL_PARTNER_LINKS_CACHE_; }
 } catch (e) {}

 var sheet = getExternalKnowledgeSheetOrDie_();
 var values = sheet.getDataRange().getValues();
 if (values.length < 2) { EXTERNAL_PARTNER_LINKS_CACHE_ = []; return []; }
 if (String(values[0][0] || "").trim().toUpperCase() !== "DRIVE URL") {
  throw new Error("FATAL(EXTERNAL): " + CONFIG.EXTERNAL_KB_SHEET_NAME + " must have 'Drive URL' in cell A1. Only column A is read. Status columns to the right (Name / Type / Status / Last Refreshed) are populated by the refresh and are ignored by the resolver.");
 }

 var resolved = [];
 var seenIds = {};
 for (var r = 1; r < values.length; r++) {
  var url = String(values[r][0] || "").trim();
  if (!url) continue;
  var metadata = getExternalDriveFileMetadata_(url);
  if (!metadata || seenIds[metadata.id]) continue;
  seenIds[metadata.id] = true;
  if (isRestrictedExternalMetadata_(metadata)) {
   log("External partner link filtered by [R] restriction: " + metadata.title + " | " + url);
   continue;
  }
  resolved.push({ url: url, title: metadata.title, row: r + 1 });
 }
 EXTERNAL_PARTNER_LINKS_CACHE_ = resolved;
 try { CacheService.getScriptCache().put(EXTERNAL_PARTNER_LINKS_CACHE_KEY_, JSON.stringify(resolved), EXTERNAL_PARTNER_LINKS_TTL_SECONDS_); } catch (e) {}
 return resolved;
}

