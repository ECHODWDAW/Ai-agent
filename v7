 // instead of gaining a second sign-off.
 var signOffPattern = /(?:^|(?:<br\s*\/?>|\r?\n)+|<(?:p|div)\b[^>]*>)\s*(?:best regards|kind regards|warm regards|regards|sincerely|cheers),?(?:(?:<br\s*\/?>|\r?\n|\s)+[\s\S]*)?$/i;
 if (signOffPattern.test(cleaned)) {
  return cleaned.replace(signOffPattern, "<br><br>" + signOff);
 }

 return cleaned + "<br><br>" + signOff;
}

function ensureGreetingLineBreak_(html) {
 return String(html || "").replace(/^((?:Hi|Hello|Dear|Good morning|Good afternoon|Good evening)\b[^,<]{0,80},)(?!\s*<br\s*\/?>)/i, "$1<br><br>");
}

function removeUsdDisclaimerSentences_(html) {
 // Remove every model-written USD pricing disclaimer, including variants with
 // inline formatting or irregular spacing. One canonical sentence is re-added.
 var w = "(?:\\s|&nbsp;|<\\/?(?:b|strong|i|em|u|span)[^>]*>)+";
 var wOpt = "(?:\\s|&nbsp;|<\\/?(?:b|strong|i|em|u|span)[^>]*>)*";
 var tail = "(?:[^.!?<]|<\\/?(?:b|strong|i|em|u|span)[^>]*>)*";
 var pattern = new RegExp(
  "(?:(?:&nbsp;|\\s)*<br\\s*\\/?>)*(?:&nbsp;|\\s)*"
  + "All" + w + "prices" + w
  + "(?:(?:are|is|listed|shown|quoted)" + w + "){0,3}"
  + "in" + w
  + "(?:USD|US" + w + "Dollars(?:" + wOpt + "\\(USD\\))?)"
  + tail + "[.!?]?",
  "gi"
 );
 return String(html || "").replace(pattern, "");
}

function dedupeUsdFreightDisclaimers_(html) {
 // Final safety net: keep only the FIRST sentence combining a currency
 // mention (USD / US Dollars) with freight/handling/tax wording. Does not
 // require the word "prices", so variants like "All quotations are in USD,
 // excluding freight..." are caught too.
 var pattern = /(?:(?:&nbsp;|\s)*<br\s*\/?>)*(?:&nbsp;|\s)*[^<>.!?]{0,120}\b(?:USD|US\s+Dollars)\b[^<>.!?]{0,160}\b(?:freight|handling|applicable\s+taxes)\b[^<>.!?]{0,120}[.!?]?/gi;
 var seen = false;
 return String(html || "").replace(pattern, function(match) {
  if (seen) return "";
  seen = true;
  return match;
 });
}

function stripPricingBoilerplate_(html) {
 return removeUsdDisclaimerSentences_(String(html || ""))
  .replace(/((?:^|[.!?]|<br\s*\/?>)\s*)(?:Our\s+)?(?:sales|internal)\s+team\s+will\s+(?:follow up with|provide)\s+a\s+tailored\s+quote(?:\s+if\s+needed)?\.?/ig, "$1")
  .replace(/(?:<br\s*\/?>\s*){3,}/ig, "<br><br>");
}

// The USD disclaimer is script-owned. This predicate is its single trigger.
function replyContainsPriceFigure_(html) {
 // True only when the reply actually shows a monetary figure. Used to gate the
 // "All prices are quoted in USD..." sentence so it never appears on a reply
 // that quoted no price. Requires a currency token adjacent to a digit, so
 // spec numbers (512GB, 1TB, 99%, 256-bit) never count as prices.
 var plain = String(html || "").replace(/<[^>]+>/g, " ");
 return /(?:US\$|S\$|SGD|USD|\$)\s?\d/i.test(plain)
  || /\d[\d,]*(?:\.\d+)?\s?(?:USD|SGD)\b/i.test(plain);
}

function shouldAppendUsdFooter_(subject, body) {
 var queryText = ((subject || "") + " " + (body || "")).toLowerCase();

 // Direct price, quote, or cost intent.
 if (containsAnyText_(queryText, PRICING_KEYWORDS)) return true;

 // Guard tier comparisons: Lite / Essential / Premium.
 // Switch/upgrade-only questions ("can I upgrade my Lite drive?") are
 // technical, not commercial - no disclaimer unless they also ask about
 // differences or features (price wording is covered by the check above).
 if (isGuardPackageSeriesQuery_(queryText)) {
  var isSwitchOnlyQuestion = containsAnyText_(queryText, ["upgrad", "downgrad", "switch"])
   && !containsAnyText_(queryText, [
    "difference", "differences", "differ", "compare", "comparison",
    "what are the", "which series", "feature", "features", "tier list",
   ]);
  if (!isSwitchOnlyQuestion) return true;
 }

 // NOTE: pure product-info / "tell me about X" / feature-comparison questions
 // deliberately do NOT trigger the footer. Those replies quote no price, so a
 // "prices are in USD ... tailored quote" footer is irrelevant and reads as an
 // unprompted sales nudge. The footer is reserved for genuine pricing intent
 // (the keyword check above) or a Guard-tier commercial comparison.

 return false;
}

function ensurePricingFooterPlacement_(html, subject, body) {
 // A scope decline (distributor/reseller/below-list pricing) quotes no figure
 // and ends with the internal-team line - it must not carry a pricing footer.
 if (/outside my (?:customer-support )?scope/i.test(String(html || ""))) {
  return stripPricingBoilerplate_(html);
 }
 if (TABLE_MODE_ACTIVE_ || !shouldAppendUsdFooter_(subject, body)) {
  // Table/benchmark replies and non-pricing replies never carry the USD/quote
  // footer: strip any model-written boilerplate and add nothing.
  return stripPricingBoilerplate_(html);
 }

 var cleaned = String(html || "");
 var usdSentence = "All prices are quoted in US Dollars (USD) and exclude freight, handling, and applicable taxes.";
 // Preserve the model's sales-follow-up sentence. Remove every USD disclaimer
 // variant, then re-add exactly one canonical sentence below.
 cleaned = removeUsdDisclaimerSentences_(cleaned);

 var alreadyHasSalesFollowUp = /(?:sales|internal)\s+team\s+(?:and\s+they\s+|who\s+)?will\s+(?:follow\s+up|provide|be\s+in\s+touch|contact|reach\s+out)/i.test(cleaned)
  || /forwarded\s+to\s+(?:our\s+|the\s+)?(?:sales|internal)\s+team/i.test(cleaned)
  || /(?:sales|internal)\s+team\s+(?:for|with)\s+a\s+tailored\s+quote/i.test(cleaned);
 // A bulk/volume customer explicitly asked for the quote - no "if needed" hedge.
 var salesSentence = isBulkPricingInquiry_(subject, body)
  ? "Our internal team will follow up with a tailored quote."
  : "Our internal team will follow up with a tailored quote if needed.";
 // Only assert the USD disclaimer when the reply actually shows a price.
 var replyHasPrice = replyContainsPriceFigure_(cleaned);
 var usdPart = replyHasPrice ? usdSentence : "";
 // Only append the tailored-quote follow-up on genuine pricing replies (a price
 // figure, or an explicit pricing/bulk inquiry) - never on tables or general replies.
 var pricingReply = replyHasPrice || isPricingQuery([subject], body) || isBulkPricingInquiry_(subject, body);
 var salesPart = (alreadyHasSalesFollowUp || !pricingReply) ? "" : salesSentence;
 if (!usdPart && !salesPart) return cleaned; // nothing to append
 var footerInner = usdPart + (usdPart && salesPart ? "<br>" : "") + salesPart;
 var footer = "<br><br>" + footerInner + "<br><br>";
 if (/Best regards,/i.test(cleaned)) {
  cleaned = cleaned.replace(/(?:<br\s*\/?>|\s)*Best regards,/i, footer + "Best regards,");
 } else {
  cleaned += footer;
 }

 return cleaned;
}

function normalizeEmailPunctuation_(html) {
 return String(html || "")
  .replace(/[\u2013\u2014\u2015]/g, " - ")
  .replace(/[\u2018\u2019]/g, "'")
  .replace(/[\u201C\u201D]/g, '"')
  .replace(/\u2026/g, "...")
  .replace(/\u00A0/g, " ")
  .replace(/\s+-\s+/g, " - ");
}

function collapseExcessLineBreaks_(html) {
 // Different post-processing steps and model habits can stack <br> runs
 // between the last answer paragraph and the lead-in/sign-off. Collapse any
 // run of 3+ breaks (whitespace and &nbsp; allowed between) to a clean
 // paragraph gap. Runs of exactly 2 are intentional and untouched.
 return String(html || "").replace(/(?:(?:\s|&nbsp;)*<br\s*\/?>){3,}(?:\s|&nbsp;)*/gi, "<br><br>");
}

function stripSelfReferralContact_(html) {
 // The agent must never point customers at its own inbox as the "product
 // team" contact - that is a closed loop. Rewrite such directions to the
 // in-person hand-off. The plain signature line "Email: ethan@x-phy.com"
 // is untouched because this pattern requires the team-contact phrasing.
 var scrubbed = String(html || "").replace(
  /((?:product|technical|our)\s+team[^.<]{0,60}?)\bat\s+ethan@x-phy\.com(?:\s*\(mailto:ethan@x-phy\.com\))?/gi,
  "$1in person");
 if (scrubbed !== html) {
  log(" Self-referral scrub: rewrote a 'contact the team at ethan@x-phy.com' direction to the in-person hand-off");
 }
 return scrubbed;
}

function removeButtonStyleLinks_(html) {
 return html.replace(/<a\b([^>]*style=["'][^"']*display\s*:\s*inline-block[^"']*["'][^>]*)>([\s\S]*?)<\/a>/gi, function(match, attrs, label) {
  var hrefMatch = attrs.match(/href=["']([^"']+)["']/i);
  if (!hrefMatch) return stripHtmlTags_(label);
  return '<a href="' + hrefMatch[1] + '">' + stripHtmlTags_(label) + '</a>';
 });
}

function stripHtmlTags_(html) {
 return String(html || "").replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
}

function containsAnyText_(text, needles) {
 for (var i = 0; i < needles.length; i++) {
  if (text.indexOf(needles[i]) >= 0) return true;
 }
 return false;
}

function escapeHtml_(value) {
 return String(value || "")
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(/"/g, "&quot;")
  .replace(/'/g, "&#39;");
}

function countProductMentions_(text) {
 var products = [
  ["secure ssd", "ssd", "guard application"],
  ["deepfake detector", "deep fake", "dfd"],
  ["server defender"],
  ["management console"],
  ["guard pc"],
  ["ciphervault", "cipher vault", "secure usb"],
  ["trustsign"],
  ["trustrom"],
  ["immutable", "static", "stealth"],
  ["ace", "cyberpad", "zepto", "secure laptop"],
 ];
 var count = 0;
 for (var i = 0; i < products.length; i++) {
  if (containsAnyText_(text, products[i])) count++;
 }
 return count;
}

function logClaudeTokenUsage_(data) {
 try {
  var configSpreadsheetId = CONFIG.CONFIG_SPREADSHEET_ID || PropertiesService.getScriptProperties().getProperty("CONFIG_SPREADSHEET_ID") || "";
  if (!configSpreadsheetId) {
   log(" Token API log skipped: CONFIG_SPREADSHEET_ID is not set.");
   return;
  }
  CONFIG.CONFIG_SPREADSHEET_ID = configSpreadsheetId;
  var spreadsheet = SpreadsheetApp.openById(configSpreadsheetId);
  var sheetName = CONFIG.TOKEN_API_LOG_SHEET_NAME || "TOKEN_API_LOG";
  var sheet = spreadsheet.getSheetByName(sheetName) || spreadsheet.insertSheet(sheetName);
  var headers = [
   "Timestamp", "Operation", "Model", "Sender", "Subject",
   "Input Tokens", "Output Tokens", "Cache Creation Tokens", "Cache Read Tokens",
   "Total Billed Tokens", "Estimated Cost USD", "Response Characters",
  ];

  if (sheet.getLastRow() === 0) {
   sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
   sheet.getRange(1, 1, 1, headers.length).setFontWeight("bold");
   formatTokenApiLogSheet_(sheet);
  }

  var usage = data.usage || {};
  var inputTokens = Number(usage.input_tokens || 0);
  var outputTokens = Number(usage.output_tokens || 0);
  var cacheCreationTokens = Number(usage.cache_creation_input_tokens || 0);
  var cacheReadTokens = Number(usage.cache_read_input_tokens || 0);
  var totalTokens = inputTokens + outputTokens + cacheCreationTokens + cacheReadTokens;
  var estimatedCost = estimateClaudeCostUsd_(data.model, inputTokens + cacheCreationTokens, outputTokens);

  var nextRow = getNextTokenLogRow_(sheet);
  sheet.getRange(nextRow, 1, 1, headers.length).setValues([[
   new Date(),
   data.operation || "message",
   data.model || "",
   data.sender || "",
   data.subject || "",
   inputTokens,
   outputTokens,
   cacheCreationTokens,
   cacheReadTokens,
   totalTokens,
   estimatedCost,
   data.responseChars || 0,
  ]]);
 } catch (e) {
  log(" Could not write token API log: " + e.message);
 }
}

function getNextTokenLogRow_(sheet) {
 var lastRow = Math.max(sheet.getLastRow(), 1);
 var values = sheet.getRange(1, 1, lastRow, 1).getValues();
 for (var i = values.length - 1; i >= 1; i--) {
  if (values[i][0]) return i + 2;
 }
 return 2;
}

function testTokenApiLog_() {
 logClaudeTokenUsage_({
  operation: "test",
  model: CONFIG.CLAUDE_MODEL,
  sender: "test",
  subject: "Token log test",
  usage: {
   input_tokens: 1,
   output_tokens: 1,
  },
  responseChars: 0,
 });
 log("Token API log test complete. Check the TOKEN_API_LOG tab.");
}

function compactTokenApiLog_() {
 var configSpreadsheetId = CONFIG.CONFIG_SPREADSHEET_ID || PropertiesService.getScriptProperties().getProperty("CONFIG_SPREADSHEET_ID") || "";
 if (!configSpreadsheetId) throw new Error("CONFIG_SPREADSHEET_ID is not set.");
 var spreadsheet = SpreadsheetApp.openById(configSpreadsheetId);
 var sheet = spreadsheet.getSheetByName(CONFIG.TOKEN_API_LOG_SHEET_NAME || "TOKEN_API_LOG");
 if (!sheet || sheet.getLastRow() < 2) {
  log("No token log rows to compact.");
  return;
 }

 var headers = [
  "Timestamp", "Operation", "Model", "Sender", "Subject",
  "Input Tokens", "Output Tokens", "Cache Creation Tokens", "Cache Read Tokens",
  "Total Billed Tokens", "Estimated Cost USD", "Response Characters",
 ];
 var values = sheet.getRange(2, 1, sheet.getLastRow() - 1, headers.length).getValues();
 var dataRows = [];
 for (var i = 0; i < values.length; i++) {
  if (values[i][0]) dataRows.push(values[i]);
 }

 sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
 if (sheet.getMaxRows() > 1) {
  sheet.getRange(2, 1, sheet.getMaxRows() - 1, headers.length).clearContent();
 }
 if (dataRows.length > 0) {
  sheet.getRange(2, 1, dataRows.length, headers.length).setValues(dataRows);
 }
 formatTokenApiLogSheet_(sheet);
 log("Compacted TOKEN_API_LOG to " + dataRows.length + " row(s).");
}

function estimateClaudeCostUsd_(modelId, inputTokens, outputTokens) {
 var pricing = getClaudeTokenPricing_(modelId);
 if (!pricing) return "";
 var inputCost = (Number(inputTokens || 0) / 1000000) * pricing.input;
 var outputCost = (Number(outputTokens || 0) / 1000000) * pricing.output;
 return Math.round((inputCost + outputCost) * 1000000) / 1000000;
}

function getClaudeTokenPricing_(modelId) {
 var model = String(modelId || "").toLowerCase();
 if (model.indexOf("haiku") >= 0) return { input: 1, output: 5 };
 if (model.indexOf("sonnet") >= 0) return { input: 3, output: 15 };
 if (model.indexOf("opus") >= 0) return { input: 15, output: 75 };
 return null;
}

// True when the sender included an HTML table for Ethan to complete, or
// explicitly asked for a table / structured comparison. General by design:
// keys on structure + explicit request, never on any topic or question set.
function senderWantsTable_(subject, body) {
 var raw = String(body || "");
 if (/<table\b/i.test(raw)) return true;                      // an HTML table to fill
 var text = ((subject || "") + " " + raw).toLowerCase();

 // Explicit request phrasings (any of these).
 if (containsAnyText_(text, [
  "in a table", "as a table", "in table form", "tabular", "table format",
  "fill in the table", "fill out the table", "complete the table",
  "answer each question", "address each", "pointer question", "comparison table",
  "side by side", "side-by-side", "benchmark", "overcome", "objection", "objections",
  "attached question", "the questions below", "which of the", "counter response",
  "feature comparison", "feature-comparison",
 ])) return true;

 // Structural detection: a plain-text question/assessment table pasted into the body.
 // (These internal benchmark emails often arrive as tab-collapsed text with no <table>.)
 if (/\bhp question\b/i.test(raw) && /\bassessment\b/i.test(raw)) return true;
 var questionLines = (raw.match(/\?\s*(\r?\n|$)/g) || []).length;
 if (questionLines >= 4) return true;                          // several stacked questions = a table to fill

 return false;
}

function getClaudeMaxTokensForRequest_(subject, body) {
 var queryText = ((subject || "") + " " + (body || "")).toLowerCase();
 var maxTokens = CONFIG.CLAUDE_MAX_TOKENS;
 if (containsAnyText_(queryText, PRICING_KEYWORDS)) {
  // Pricing tables need more output room than ordinary short replies. Keep
  // the global default unchanged for every other request.
  maxTokens = Math.max(maxTokens, 1400);
 }
 if (isGuardPackageSeriesQuery_(queryText)) {
  // The feature matrix table plus several other answers in one email can
  // exceed the pricing budget; never let the table be the thing that gets
  // cut when max_tokens is reached.
  maxTokens = Math.max(maxTokens, 1600);
 }
 if (senderWantsTable_(subject, body)) {
  // A multi-row table the sender asked Ethan to fill needs far more output
  // room than an ordinary reply so the table is never cut off mid-render.
  maxTokens = Math.max(maxTokens, 2000);
 }
 return maxTokens;
}

function callClaude(sender, senderName, subject, body, knowledgeContext) {
  // Internal colleagues asking to fill a table/benchmark get a reframed, in-scope
  // directive (KB-retrieval + honest gap summary), not the out-of-scope refusal.
  TABLE_MODE_ACTIVE_ = (!isExternalMode_() && senderWantsTable_(subject, body));
 LAST_CLAUDE_MODEL_USED_ = "";
 // Rebuild the list of documents Ethan is allowed to link for THIS sender,
 // from the knowledge base that was just searched for them.
 registerApprovedLinksForReply_(knowledgeContext);
 var customerIntentText = getBodyPreferredIntentText_(subject, body);
 var definitionInstruction = isGeneralDefinitionQuery_(customerIntentText)
  ? "\nThis appears to be a basic definition question. Explain the general concept first in simple terms, then add one short sentence on how it relates to X-PHY if relevant. Do not lead with a full X-PHY product pitch.\n"
  : "";
 var curiosityInstruction = isProductInfoQuestion_(customerIntentText)
  && !isGuidedUseRequestText_(customerIntentText)
  && !isSupportRequestText_(customerIntentText)
  ? "\nThis is a product curiosity question only. Keep the answer to one brief overview paragraph. Do not include setup, installation, guide, troubleshooting, or support-page details unless the customer explicitly asked for them.\n"
  : "";
 var mixedIntentInstruction = isProductInfoQuestion_(customerIntentText)
  && (isGuidedUseRequestText_(customerIntentText) || isSupportRequestText_(customerIntentText))
  ? "\nThis is a mixed-intent email. Treat each product separately. For products the customer is only curious about, give a brief overview only and do not include requirements, setup steps, guides, support pages, or troubleshooting. For products the customer specifically asks to install, configure, or get help with, answer that setup/support request directly.\n"
  : "";
 var capacityLock = getRequestedSsdCapacityLock_(subject, body);
 var pricingInstruction = containsAnyText_(customerIntentText.toLowerCase(), PRICING_KEYWORDS)
  ? "\nPRICING OUTPUT REQUIREMENT: Emit plain, unstyled <table><tr><td> markup; the script applies all styling later. For capacity variants, use one capacity per column, a capacity header row, and one row per tier. Format each value as '<Tier>: <Part Number> / $<Price>'. Include every requested tier, including Premium, even if the intro must be shortened. Close every <tr> and </table> before the sign-off. For one-dimensional pricing, use one column with one '<Label>: <Part Number> / $<Price>' row per option and no header. A single quoted price may remain in prose."
   + (capacityLock
    ? " CAPACITY LOCK: the customer asked for the " + capacityLock.keep + " capacity ONLY. Quote ONLY the " + capacityLock.keep + " column - its header, part numbers, and prices. Do NOT include the other capacity's column, part numbers, or prices anywhere in the reply, and do not mention the other capacity in prose. 'Show both capacities' applies only when no capacity is named, which is not the case here."
    : "")
   + "\n"
  : "";
 // NEW: format lock for multi-question emails - one short bold-labelled
 // paragraph per question, no unrequested specifications. This is the
 // content-side half of the fix; splitInlineTopicLabelsIntoParagraphs_
 // in post-processing is the deterministic layout-side half.
 var multiQuestionInstruction = isMultiQuestionEmail_((subject || "") + " " + (body || ""))
  ? "\nMULTI-QUESTION FORMAT LOCK: This email asks several distinct questions. Answer EACH question in its OWN short paragraph, in the order asked, separated by <br><br>. Start each paragraph with a short bold topic label ending in a colon (for example '<b>Deepfake Detector:</b>' or '<b>Wipe Data vs. Rapid Purge:</b>'), then 1 to 3 concise sentences answering ONLY that question - never more than about 50 words per paragraph. Never merge two questions into one paragraph, and never continue a new topic on the same line as the previous answer. Answer at the level the question was asked: do not add encryption bit-strengths, remote-unlock procedures, app names, OS support lists, capacity or tier details, subscription terms, or any specification the customer did not explicitly ask about. A curated context block's own RESPONSE INSTRUCTION (for example the Wipe Data vs Rapid Purge structure rules) still applies to its topic.\n"
  : "";
 var productIntentInstruction = buildProductSpecificReplyInstruction_(customerIntentText);
 var userPrompt = "CUSTOMER EMAIL:\n"
  + "From: " + sender + "\n"
  + "Customer's name: " + senderName + "\n"
  + "Subject: " + subject + "\n"
  + "Body:\n" + body + "\n\n"
  + "KNOWLEDGE BASE CONTEXT:\n" + knowledgeContext + "\n\n"
  + getForwardedEmailInstructionForCurrentEmail_(sender, senderName)
  + definitionInstruction
  + curiosityInstruction
  + mixedIntentInstruction
  + pricingInstruction
  + multiQuestionInstruction
  + productIntentInstruction
  + "Please draft a concise reply to this customer's email in HTML format using the knowledge base context above. For one topic, keep it to one short paragraph before the sign-off. For multiple distinct products or topics, use one short paragraph per product/topic before the sign-off.";

 var models = [
  { id: CONFIG.CLAUDE_MODEL, name: "Primary", retries: 3 },
  { id: CONFIG.CLAUDE_FALLBACK_MODEL, name: "Fallback", retries: 3 },
 ];
 var maxTokensForRequest = getClaudeMaxTokensForRequest_(subject, body);

 for (var m = 0; m < models.length; m++) {
  var model = models[m];
  log(" Trying " + model.name + "...");

  var payload = {
   model: model.id,
   max_tokens: maxTokensForRequest,
   temperature: CONFIG.CLAUDE_TEMPERATURE,
   system: getSystemPrompt_(),
   messages: [{ role: "user", content: userPrompt }],
  };
  // Web search: general questions may search the web; X-PHY facts stay DB-only
  // per the KNOWLEDGE SOURCE BOUNDARY rule. Off-switch: Script Property CLAUDE_WEB_OFF=1.
  var webTools_ = claudeWebSearchTools_();
  if (webTools_) payload.tools = webTools_;

  var options = {
   method: "post",
   contentType: "application/json",
   headers: {
    "x-api-key": CONFIG.CLAUDE_API_KEY,
    "anthropic-version": "2023-06-01",
   },
   payload: JSON.stringify(payload),
   muteHttpExceptions: true,
  };

  for (var attempt = 1; attempt <= model.retries; attempt++) {
   var claudeResult_ = fetchClaudeMessage_(payload, options);
   var statusCode = claudeResult_.statusCode;
   var responseText = claudeResult_.responseText;
   var responseBody = claudeResult_.responseBody;

   if (statusCode === 200) {
    log(" " + model.name + " stop_reason: " + (responseBody.stop_reason || "unknown"));
    var replyText = "";
    for (var i = 0; i < responseBody.content.length; i++) {
     if (responseBody.content[i].type === "text") {
      replyText += responseBody.content[i].text;
     }
    }

    // Bill-time accounting: tokens are spent the moment the API responds,
    // so log them before any step that could still fail.
    logClaudeTokenUsage_({
     operation: "reply",
     model: model.id,
     sender: sender,
     subject: subject,
     usage: responseBody.usage,
     responseChars: (replyText || "").length,
    });

    var webSearches_ = (responseBody.usage && responseBody.usage.server_tool_use
     && responseBody.usage.server_tool_use.web_search_requests) || 0;
    if (webSearches_ > 0) log(" Web searches used: " + webSearches_ + " (~$" + (webSearches_ * 0.01).toFixed(2) + " search fee)");

    if (!replyText || replyText.trim().length === 0) {
     log(" " + model.name + " returned an empty response; processEmail will use the empty-reply guard");
     LAST_CLAUDE_MODEL_USED_ = model.id;
     return "";
    }

    replyText = postProcessAiReply_(replyText, subject, body, senderName);
    LAST_CLAUDE_MODEL_USED_ = model.id;

    // Token usage already logged at response time (bill-time accounting).

    log(" " + model.name + " generated " + replyText.length + " characters after cleanup");
    return replyText;
   }

   var lastError = (responseBody.error && responseBody.error.message) || ("HTTP " + statusCode);

   if (isRetryableHttpStatus_(statusCode)) {
    var waitTime = Math.min(10 * Math.pow(2, attempt - 1), 30);
    log(" " + model.name + " attempt " + attempt + "/" + model.retries + " " + lastError + ". Waiting " + waitTime + "s...");
    Utilities.sleep(waitTime * 1000);
    continue;
   }

   if (m < models.length - 1) {
    log(" " + model.name + " failed: " + lastError + " trying next model...");
    break;
   }

   throw new Error("Claude API error: " + lastError);
  }
 }

 throw new Error("All models failed after retries. Anthropic API may be experiencing an outage.");
}

