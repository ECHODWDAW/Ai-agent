function isPricingQuery(keywords, body) {
 var combined = (keywords.join(" ") + " " + body).toLowerCase();
 for (var i = 0; i < PRICING_KEYWORDS.length; i++) {
  if (combined.indexOf(PRICING_KEYWORDS[i]) >= 0) return true;
 }
 return false;
}

function getPricingData() {
 try {
  var cachedPricing = CacheService.getScriptCache().get(PRICING_DATA_CACHE_KEY_);
  if (cachedPricing) {
   log(" Loaded pricing data from cache");
   return cachedPricing;
  }

  var ss = SpreadsheetApp.openById(PRICING_SHEET_ID);
  var sheets = ss.getSheets();
  var pricingText = "\n=== MASTER PRICELIST (use ONLY these list prices for quotations) ===\n";
  pricingText += "Original link: https://docs.google.com/spreadsheets/d/" + PRICING_SHEET_ID + "/edit\n\n";

  for (var s = 0; s < sheets.length; s++) {
   var sheet = sheets[s];
   var sheetName = sheet.getName();
   var data = sheet.getDataRange().getValues();

   pricingText += "--- Sheet: " + sheetName + " ---\n";

   for (var r = 0; r < data.length; r++) {
    var row = [];
    for (var c = 0; c < data[r].length; c++) {
     var cell = String(data[r][c]).trim();
     if (cell.length > 0) row.push(cell);
    }
    if (row.length > 0) {
     pricingText += row.join(" | ") + "\n";
    }
   }
   pricingText += "\n";
  }

  log(" Loaded pricing data from master pricelist");
  try {
   CacheService.getScriptCache().put(PRICING_DATA_CACHE_KEY_, pricingText, CONFIG.EDITABLE_CONFIG_CACHE_TTL_SECONDS || 1800);
  } catch (cacheError) {
   // A large pricelist can exceed Apps Script's per-entry cache limit. The
   // sheet read still succeeded, so return the fresh data instead of letting
   // a cache-only failure make pricing context disappear from the reply.
   log(" Pricing data cache write skipped: " + cacheError.message);
  }
  return pricingText;
 } catch (e) {
  log(" Could not load pricing sheet: " + e.message);
  return "";
 }
}


