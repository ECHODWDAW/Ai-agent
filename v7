function findForwardBoundary_(text) {
 var source = String(text || "");
 var hasDivider = false;
 var bestIndex = -1;
 var bestLength = 0;

 function consider(match, consumedLength) {
  if (!match) return;
  if (bestIndex < 0 || match.index < bestIndex) {
   bestIndex = match.index;
   bestLength = consumedLength;
  }
 }

 // 1. An explicit divider: "---------- Forwarded message ----------",
 //    "Begin forwarded message:", "-----Original Message-----".
 for (var i = 0; i < FORWARD_DIVIDER_PATTERNS_.length; i++) {
  var dividerMatch = source.match(FORWARD_DIVIDER_PATTERNS_[i]);
  if (dividerMatch) {
   hasDivider = true;
   consider(dividerMatch, dividerMatch[0].length);
  }
 }

 // 2. A quoted header block - Outlook and most mobile clients. Length 0
 //    because parseForwardedHeaderBlock_ still has to read those header lines.
 consider(source.match(FORWARD_QUOTED_HEADER_RE_), 0);

 // 3. "On <date>, <name> wrote:" - what Gmail writes when somebody replies
 //    from inside an existing conversation and adds Ethan to it. There is no
 //    divider and no header block in that case, so without this the whole
 //    conversation was cut away and Ethan saw only the new sentence.
 var inlineMatch = source.match(FORWARD_INLINE_QUOTE_RE_);
 consider(inlineMatch, inlineMatch ? inlineMatch[0].length : 0);

 if (bestIndex < 0) return null;
 // A divider anywhere means forwarded content is present. Otherwise this is a
 // conversation quoted underneath a reply, and the wording sent to Claude
 // stays neutral about how it got there.
 return { index: bestIndex, dividerLength: bestLength, kind: hasDivider ? "forward" : "quoted-thread" };
}

function parseForwardedHeaderBlock_(text) {
 var lines = String(text || "").split("\n");
 var headers = { from: "", date: "", to: "", cc: "", subject: "" };
 var headerCount = 0;
 var i = 0;

 while (i < lines.length && !lines[i].replace(/^[ \t>]+/, "").trim()) i++;

 for (; i < lines.length && i < 40; i++) {
  var line = lines[i].replace(/^[ \t>]+/, "").trim();
  if (!line) { i++; break; }
  var match = line.match(/^(From|Sent|Date|To|Cc|Bcc|Subject|Reply-To)[ \t]*:[ \t]*(.*)$/i);
  if (!match) break;
  var key = match[1].toLowerCase();
  var value = String(match[2] || "").trim();
  if (key === "from") headers.from = value;
  else if (key === "sent" || key === "date") headers.date = value;
  else if (key === "to") headers.to = value;
  else if (key === "cc") headers.cc = value;
  else if (key === "subject") headers.subject = value;
  headerCount++;
 }

 return { headers: headers, headerCount: headerCount, bodyLines: lines.slice(i) };
}

