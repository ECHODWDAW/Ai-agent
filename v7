// WEB SEARCH (native Anthropic tool)
// ========================
// Enabled only for callClaude (email replies). Org-wide off-switch:
// set Script Property CLAUDE_WEB_OFF = "1". Claude decides when to search;
// the KNOWLEDGE SOURCE BOUNDARY prompt keeps X-PHY facts database-only.
function claudeWebSearchEnabled_() {
 try {
  return PropertiesService.getScriptProperties().getProperty("CLAUDE_WEB_OFF") !== "1";
 } catch (e) {
  return true;
 }
}

function claudeWebSearchTools_() {
 if (!claudeWebSearchEnabled_()) return null;
 return [{ type: "web_search_20250305", name: "web_search", max_uses: 4 }];
}

function claudeShallowClone_(obj) {
 var out = {};
 for (var k in obj) { if (Object.prototype.hasOwnProperty.call(obj, k)) out[k] = obj[k]; }
 return out;
}

function claudeErrorIsWebSearchUnsupported_(responseBody) {
 var msg = (responseBody && responseBody.error && responseBody.error.message) ? String(responseBody.error.message).toLowerCase() : "";
 if (!msg) return false;
 if (msg.indexOf("web_search") >= 0 || msg.indexOf("web search") >= 0) return true;
 return msg.indexOf("tool") >= 0 && (msg.indexOf("not enabled") >= 0 || msg.indexOf("not supported") >= 0
  || msg.indexOf("not allowed") >= 0 || msg.indexOf("disabled") >= 0 || msg.indexOf("unsupported") >= 0);
}

// Sends one Messages API request, transparently handling:
//  - pause_turn continuation (agentic web search spanning multiple turns)
//  - graceful fallback: if web search is disabled/unsupported on the org,
//    retry the SAME request once WITHOUT tools so Ethan still answers.
// Returns { statusCode, responseText, responseBody }.
function fetchClaudeMessage_(payloadObj, baseOptions) {
 var url = "https://api.anthropic.com/v1/messages";
 var MAX_PAUSE_CONTINUATIONS = 5;
 var current = payloadObj;
 var strippedTools = false;

 for (var step = 0; step <= MAX_PAUSE_CONTINUATIONS; step++) {
  var opts = {
   method: baseOptions.method,
   contentType: baseOptions.contentType,
   headers: baseOptions.headers,
   muteHttpExceptions: true,
   payload: JSON.stringify(current),
  };
  var response = UrlFetchApp.fetch(url, opts);
  var statusCode = response.getResponseCode();
  var responseText = response.getContentText();
  var responseBody;
  try { responseBody = JSON.parse(responseText); }
  catch (e) { responseBody = { error: { message: responseText.substring(0, 500) } }; }

  // Graceful fallback: org has web search off -> drop tools, retry once.
  if (statusCode !== 200 && current.tools && !strippedTools && claudeErrorIsWebSearchUnsupported_(responseBody)) {
   log(" Web search tool rejected by API; retrying this request without web search.");
   var noTools = claudeShallowClone_(current);
   delete noTools.tools;
   current = noTools;
   strippedTools = true;
   continue;
  }

  // Agentic web search may pause; append the assistant turn and continue.
  if (statusCode === 200 && responseBody.stop_reason === "pause_turn" && Array.isArray(responseBody.content)) {
   if (step === MAX_PAUSE_CONTINUATIONS) {
    log(" Web search hit max pause_turn continuations; returning partial result.");
    return { statusCode: statusCode, responseText: responseText, responseBody: responseBody };
   }
   var cont = claudeShallowClone_(current);
   cont.messages = current.messages.concat([{ role: "assistant", content: responseBody.content }]);
   current = cont;
   log(" Web search pause_turn -> continuing (" + (step + 1) + ")");
   continue;
  }

  return { statusCode: statusCode, responseText: responseText, responseBody: responseBody };
 }
 return { statusCode: 500, responseText: "", responseBody: { error: { message: "web search continuation loop exhausted" } } };
}


function isRetryableHttpStatus_(statusCode) {
 return [408, 429, 500, 502, 503, 504, 529].indexOf(statusCode) >= 0;
}


