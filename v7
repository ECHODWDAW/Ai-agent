 var cleanedTitle = cleanLinkTitle_(title);
 var existing = APPROVED_LINKS_FOR_REPLY_[key];
 if (!existing) APPROVED_LINKS_FOR_REPLY_[key] = { url: clean, title: cleanedTitle };
