// ============================================================================
// SECTION 6 OF 20: GMAIL SEARCH AND EMAIL TEXT PARSING
// Build Gmail queries, merge threads, extract plain text, and isolate the latest customer reply.
// ============================================================================

function getUnprocessedThreads() {
 var unreadQuery = buildAgentGmailQuery_(true);
 log(" Gmail unread query: " + unreadQuery);
 var threads = GmailApp.search(unreadQuery, 0, CONFIG.MAX_EMAILS_PER_RUN * 3);

 if (CONFIG.INCLUDE_READ_UNREPLIED_EMAILS && threads.length < CONFIG.MAX_EMAILS_PER_RUN) {
  var readQuery = buildAgentGmailQuery_(false);
  log(" Gmail read-unreplied query: " + readQuery);
  var readThreads = GmailApp.search(readQuery, 0, CONFIG.MAX_EMAILS_PER_RUN * 3);
  threads = mergeThreadsById_(threads, readThreads);
 }

 if (threads.length < CONFIG.MAX_EMAILS_PER_RUN * 2) {
  var followUpQuery = buildAgentFollowUpQuery_();
  log(" Gmail follow-up query: " + followUpQuery);
  var followUpThreads = GmailApp.search(followUpQuery, 0, CONFIG.MAX_EMAILS_PER_RUN * 3);
  threads = mergeThreadsById_(threads, followUpThreads);
 }

 var filtered = filterThreadsAwaitingReply_(threads);
 if (filtered.length !== threads.length) {
  log(" Filtered out " + (threads.length - filtered.length) + " thread(s) where the last message was from us");
 }

 return filtered.slice(0, CONFIG.MAX_EMAILS_PER_RUN);
}

function buildAgentGmailQuery_(unreadOnly) {
 var excludeQuery = CONFIG.EXCLUDE_LABELS.map(function(l) { return "-label:" + l; }).join(" ");
 var query = "in:" + String(CONFIG.GMAIL_LABEL || "inbox").toLowerCase() + " " + excludeQuery;
 if (unreadOnly) {
  query += " is:unread";
 } else {
  query += " is:read -label:" + CONFIG.PROCESSED_LABEL + " newer_than:" + CONFIG.MAX_READ_EMAIL_AGE_DAYS + "d";
 }
 // Audience split: the internal agent fetches approved company domains and
 // the external agent excludes them. The exact-domain gate below remains the
 // fail-closed backstop for lookalike addresses.
 query += buildAudienceGmailQuery_();
 return query;
}

function buildAudienceGmailQuery_() {
 return isExternalMode_()
  ? " -from:(@x-phy.com) -from:(@flexxon.com)"
  : " {from:(@x-phy.com) from:(@flexxon.com)}";
}

function buildAgentFollowUpQuery_() {
 var excludeQuery = CONFIG.EXCLUDE_LABELS.map(function(l) { return "-label:" + l; }).join(" ");
 var query = "in:" + String(CONFIG.GMAIL_LABEL || "inbox").toLowerCase() + " "
  + excludeQuery + " label:" + CONFIG.PROCESSED_LABEL
  + " newer_than:" + CONFIG.MAX_READ_EMAIL_AGE_DAYS + "d";
 query += buildAudienceGmailQuery_();
 return query;
}

function mergeThreadsById_(primaryThreads, secondaryThreads) {
 var seen = {};
 var merged = [];
 function addThread(thread) {
  var id = thread.getId();
  if (seen[id]) return;
  seen[id] = true;
  merged.push(thread);
 }
 for (var i = 0; i < primaryThreads.length; i++) addThread(primaryThreads[i]);
 for (var j = 0; j < secondaryThreads.length; j++) addThread(secondaryThreads[j]);
 return merged;
}

// ============================================================================
// COST FIREWALL: durable per-thread processing state
// Prevents any single conversation from being re-processed (and re-billed
// against the Claude API) unless the customer has actually sent a new message.
// State per thread: handledCount | failedAttempts | timestamp, stored in
// Script Properties and pruned after the follow-up window expires.
// ============================================================================
var THREAD_STATE_PREFIX_ = "thrState_";
var THREAD_STATE_MAX_AGE_MS_ = 8 * 24 * 60 * 60 * 1000; // just past the 7-day follow-up window
var MAX_PROCESSING_ATTEMPTS_ = 3;

// Cache of Gmail thread IDs that currently hold a draft reply, built once per
// run so the draft lookup never becomes an O(threads * drafts) scan. Only
// populated in draft-only mode (ENABLE_AUTO_REPLY = false); live-reply mode
// leaves no drafts to find, so the scan is skipped entirely there. Apps Script
// resets this global between executions, so it is fresh every run.
var DRAFT_THREAD_IDS_CACHE_ = null;

function getDraftThreadIdSet_() {
 if (DRAFT_THREAD_IDS_CACHE_) return DRAFT_THREAD_IDS_CACHE_;
 var set = {};
 // Drafts only exist when auto-reply is OFF. In live mode there is nothing to
 // scan, so this costs nothing in production.
 if (!CONFIG.ENABLE_AUTO_REPLY) {
  try {
   var drafts = GmailApp.getDrafts();
   for (var i = 0; i < drafts.length; i++) {
    try { set[drafts[i].getMessage().getThread().getId()] = true; } catch (e) {}
   }
  } catch (scanError) {
   log(" Could not scan drafts for the reprocessing check: " + scanError.message);
  }
 }
 DRAFT_THREAD_IDS_CACHE_ = set;
 return set;
}


function getThreadState_(threadId) {
 try {
  var raw = PropertiesService.getScriptProperties().getProperty(THREAD_STATE_PREFIX_ + threadId);
  if (!raw) return null;
  var parts = String(raw).split("|");
  return {
   count: parseInt(parts[0], 10) || 0,
   attempts: parseInt(parts[1], 10) || 0,
   ts: parseInt(parts[2], 10) || 0,
  };
 } catch (e) {
  return null;
 }
}

function setThreadState_(threadId, count, attempts) {
 try {
  PropertiesService.getScriptProperties().setProperty(
   THREAD_STATE_PREFIX_ + threadId,
   count + "|" + attempts + "|" + Date.now()
  );
 } catch (e) {
  log(" Could not save thread state: " + e.message);
 }
}

function cleanupThreadStates_() {
 // Prunes stale entries; cheap enough to run occasionally from the main loop.
 try {
  var props = PropertiesService.getScriptProperties();
  var all = props.getProperties();
  var now = Date.now();
  for (var key in all) {
   if (key.indexOf(THREAD_STATE_PREFIX_) !== 0) continue;
   var parts = String(all[key]).split("|");
   var ts = parseInt(parts[2], 10) || 0;
   if (now - ts > THREAD_STATE_MAX_AGE_MS_) props.deleteProperty(key);
  }
 } catch (e) {
  log(" Thread state cleanup failed: " + e.message);
 }
}

function filterThreadsAwaitingReply_(threads) {
 var selfEmails = getSelfEmailSet_();
 var kept = [];
 for (var i = 0; i < threads.length; i++) {
  var thread = threads[i];
  try {
   var messages = thread.getMessages();
   if (messages.length === 0) continue;
   var lastMessage = messages[messages.length - 1];
   var lastFrom = extractEmailAddress(lastMessage.getFrom()).toLowerCase();
   if (selfEmails[lastFrom]) {
    // The most recent message in this thread was sent by us.
    // Nothing new to reply to yet.
    continue;
   }

   // A draft reply still sitting on the thread means it is handled. Deleting
   // that draft removes it from this set, so the thread re-opens next run.
   if (getDraftThreadIdSet_()[thread.getId()]) continue;

   var state = getThreadState_(thread.getId());
   // Runaway guard only. The old count-based skip is intentionally dropped so
   // that DELETING Ethan's sent reply or draft re-opens the thread for a new
   // reply. The sent-reply case is handled by the self-sender check above; the
   // draft case by the draft-set check above. What remains is the billing
   // protection that actually matters: a thread that keeps FAILING before it
   // ever produces a reply/draft is quarantined after MAX_PROCESSING_ATTEMPTS_
   // so it can never burn Claude calls in a loop.
   if (state && state.attempts >= MAX_PROCESSING_ATTEMPTS_) continue;

   kept.push(thread);
  } catch (e) {
   log(" Could not inspect thread " + thread.getId() + ": " + e.message);
  }
 }
 return kept;
}

// ============================================================================
// TESTING: reset a thread so the next run treats it as new.
// With the draft-aware filter above, deleting a DRAFT already re-opens a
// thread on its own. For a SENT reply, deleting the message in Gmail is not
// enough by itself, because the durable per-thread state and the AI-Replied
// label live outside the message. These helpers clear all of it for a clean
// slate.
// ============================================================================
function resetThreadForReprocessing_(threadId) {
 if (!threadId) throw new Error("Pass a Gmail thread ID.");
 try {
  PropertiesService.getScriptProperties().deleteProperty(THREAD_STATE_PREFIX_ + threadId);
 } catch (e) {
  log(" Could not clear thread state for " + threadId + ": " + e.message);
 }
 var thread = GmailApp.getThreadById(threadId);
 if (!thread) throw new Error("No thread found for ID " + threadId);
 removeLabel(thread, CONFIG.PROCESSED_LABEL);
 thread.markUnread();
 log(" Reset thread " + threadId + " - durable state cleared, " + CONFIG.PROCESSED_LABEL + " label removed, marked unread. Next run will re-process it.");
}

function resetThreadsBySubject_(subjectContains) {
 if (!subjectContains) throw new Error('Pass part of the subject, e.g. resetThreadsBySubject_("Product enquiry").');
 var threads = GmailApp.search('subject:("' + subjectContains + '") newer_than:14d');
 if (threads.length === 0) {
  log(" No threads matched subject: " + subjectContains);
  return;
 }
 for (var i = 0; i < threads.length; i++) {
  resetThreadForReprocessing_(threads[i].getId());
 }
 log(" Reset " + threads.length + " thread(s) matching subject: " + subjectContains);
}


function extractPlainText(message) {
 var text = message.getPlainBody();
 if (!text || text.trim().length === 0) {
  text = message.getBody()
   .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, "")
   .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, "")
   .replace(/<[^>]+>/g, " ")
   .replace(/&nbsp;/g, " ")
   .replace(/&amp;/g, "&")
   .replace(/&lt;/g, "<")
   .replace(/&gt;/g, ">")
   .replace(/\s+/g, " ")
   .trim();
 }
 return text.substring(0, CONFIG.MAX_EMAIL_BODY_CHARS || 14000);
}

function extractLatestReplyText_(text) {
 // A forwarded or quoted conversation is rebuilt in full by the FORWARDED
 // EMAIL UNDERSTANDING section near the end of this file, instead of being
 // cut off at the "Forwarded message" / "From:" marker the original logic
 // below relies on.
 var forwardedContext = getForwardedEmailContext_(text);
 if (forwardedContext) return forwardedContext;
 return extractLatestReplyText_NATIVE_(text);
}

// The original trimming logic, unchanged. Used for ordinary emails, and for
// tidying up the covering note written above a forwarded conversation.
function extractLatestReplyText_NATIVE_(text) {
 text = String(text || "").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
 var markers = [
  "\nOn ",
  "\nFrom:",
  "\nSent:",
  "\nTo:",
  "\nCc:",
  "\nSubject:",
  "\n-----Original Message-----",
  "\n---------- Forwarded message ---------",
  "\n________________________________",
 ];

 var cutAt = text.length;
 for (var i = 0; i < markers.length; i++) {
  var idx = text.indexOf(markers[i]);
  if (idx > 0 && idx < cutAt) cutAt = idx;
 }

 var lines = text.substring(0, cutAt).split("\n");
 var kept = [];
 for (var j = 0; j < lines.length; j++) {
  var line = lines[j];
  if (/^\s*>/.test(line)) continue;
  if (/^\s*On .+wrote:\s*$/i.test(line)) break;
  kept.push(line);
 }

 var latest = kept.join("\n")
  .replace(/\n{3,}/g, "\n\n")
  .trim();

 return latest || text.trim();
}


// ============================================================================
// SECTION 7 OF 20: CLASSIFICATION, SPAM CHECKS, AND ESCALATION
// Detect support/sales/product intent, weak knowledge, spam, disabled products, and human handoff paths.
// ============================================================================

var SENTIMENT_ESCALATION_TERMS = [
 "angry", "furious", "upset", "unacceptable", "terrible", "awful",
 "complaint", "escalate", "lawsuit", "legal action", "sue",
];

var INCIDENT_ESCALATION_PHRASES = [
 "security breach", "data breach", "data was lost", "lost our data", "lost my data",
 "got hacked", "been hacked", "we were hacked", "i was hacked", "got ransomware",
 "hit by ransomware", "infected with ransomware", "ransomware attack on my",
 "ransomware attacked", "device was compromised", "account was compromised",
 "account compromised",
];

function needsHumanEscalation_(subject, body) {
 var text = (subject + " " + body).toLowerCase();
 if (containsAnyText_(text, SENTIMENT_ESCALATION_TERMS)) return true;
 if (containsAnyText_(text, INCIDENT_ESCALATION_PHRASES)) return true;
 return false;
}

function isBulkPricingInquiry_(subject, body) {
 var text = (String(subject || "") + " " + String(body || "")).toLowerCase();
 if (containsAnyText_(text, BULK_PRICING_TERMS)) return true;
 // Quantity phrasing the fixed term list can't enumerate: "40 units",
 // "250 pcs", "60 drives", "35 ssds" - two or more digits followed by a
 // quantity noun counts as a volume inquiry.
 return /\b\d{2,}\s*(?:units?|pcs?|pieces?|drives?|ssds?|licenses?|seats?)\b/.test(text);
}

function hasNonPricingQuestions_(subject, body) {
 // True when at least one question-like sentence contains no pricing wording.
 // Used so a single bulk-pricing sentence does not swallow a multi-question email.
 var raw = (subject || "") + "\n" + (body || "");
 var sentences = raw.match(/[^.?!\n]+[.?!]?/g) || [];
 var pricingTerms = BULK_PRICING_TERMS.concat([
  "pricing", "price", "quote", "quotation", "cost", "how much", "units", "unit",
 ]);
 for (var i = 0; i < sentences.length; i++) {
  var s = sentences[i].toLowerCase().trim();
  if (!s) continue;
  var isQuestionish = s.indexOf("?") >= 0
   || /\b(what|which|how|why|when|where|can i|can you|could you|may i|is it|are there|do you|does)\b/.test(s);
  if (!isQuestionish) continue;
  if (!containsAnyText_(s, pricingTerms)) return true;
 }
 return false;
}

function replyBodyLooksEmpty_(aiReply) {
 var text = String(aiReply || "")
  .replace(/<br\s*\/?>/gi, "\n")
  .replace(/<[^>]+>/g, "")
  .replace(/&nbsp;/g, " ")
  .replace(/&amp;/g, "&")
  .trim();
 text = text.replace(/^(hi|hello|dear|good morning|good afternoon|good evening)\b[^\n]*/i, "").trim();
 // Only treat these as a sign-off when they sit at the tail of the reply:
 // short sign-off line, then at most ~200 chars of signature. A body that
 // OPENS with "Thank you for..." must not be stripped as a sign-off.
 text = text.replace(/\n\s*(best regards|kind regards|warm regards|regards|sincerely|cheers|thanks|thank you)\b[^\n]{0,40}(\n[\s\S]{0,200})?$/i, "").trim();
 return text.length < 30;
}

function buildBulkPricingAcknowledgementReply_(senderName, subject, body) {
 // Canned (no Claude call, no price figures possible) but personalised:
 // echoes the product line, the requested quantity, and the pricing CHANNEL
 // the customer asked about (volume vs distributor/reseller/partner), using
 // the same forwarded-to-sales wording customers see in mixed replies.
 var name = getSafeGreetingName_(senderName) || "there";
 var text = String((subject || "") + " " + (body || ""));
 var lower = text.toLowerCase();
 var quantityMatch = text.match(/\b(\d{1,3}(?:,\d{3})+|\d{2,6})\s*(units?|pcs?|pieces?|drives?|ssds?|licenses?|seats?)\b/i);

 var intent = detectCustomerProductIntent_(lower);
 var productLabel;
 if (intent && intent.label && intent.label !== "General X-PHY") {
  productLabel = "the <b>X-PHY " + escapeHtml_(intent.label) + "</b>";
 } else if (containsAnyText_(lower, ["lite", "essential", "premium", "512gb", "512 gb", "1tb", "1 tb"])) {
  // Guard tier or capacity named without the product itself -> Secure SSD.
  productLabel = "the <b>X-PHY Secure SSD</b>";
 } else {
  productLabel = "our products";
 }

 var isPartnerChannel = containsAnyText_(lower, [
  "distributor", "reseller", "channel partner", "registered partner",
  "partner pricing", "wholesale",
 ]);
 var channelPhrase = isPartnerChannel
  ? "Distributor and partner pricing is handled directly by our internal team"
  : "Volume and bulk pricing is handled directly by our internal team";
 var requestPhrase = quantityMatch
  ? "your request for <b>" + escapeHtml_(quantityMatch[1] + " " + quantityMatch[2]) + "</b>"
  : (isPartnerChannel ? "your pricing request" : "your volume pricing request");
 var partnerPortalSentence = isPartnerChannel
  ? " If you are a registered partner, you can also access partner resources through our <a href=\"https://platform.x-phy.com/\">Partner Portal</a>."
  : "";

 return "Hi " + escapeHtml_(name) + ",<br><br>"
  + "Thank you for your interest in " + productLabel + ". " + channelPhrase + ", "
   + (CONFIG.ENABLE_INTERNAL_FORWARDING
     ? "so I have forwarded " + requestPhrase + " to them and they will follow up with a tailored quote shortly."
     : "so please reach out to them directly for " + requestPhrase + " and they can provide a tailored quote.")
   + partnerPortalSentence + "<br><br>"
  + CONFIG.SUPPORT_SIGN_OFF;
}

function buildEscalationAcknowledgementReply_(senderName) {
 var name = getSafeGreetingName_(senderName) || "there";
 // Only claim forwarding when the system actually performs it. In testing mode
 // (ENABLE_INTERNAL_FORWARDING = false) forwardToHuman_ is a no-op, so a
 // "I've forwarded your message" line would be a false claim. In that case,
 // direct the person to the team without asserting any action was taken.
 var middle = CONFIG.ENABLE_INTERNAL_FORWARDING
  ? "Thanks for reaching out. I've forwarded your message to our internal team so someone can follow up with you directly."
  : "Thanks for reaching out. This one is best handled by our internal team directly - please reach out to them and they'll be able to help you further.";
 return "Hi " + escapeHtml_(name) + ",<br><br>"
  + middle + "<br><br>"
  + CONFIG.SUPPORT_SIGN_OFF;
}

function classifyEmail_(subject, body, options) {
 options = options || {};
 var text = ((subject || "") + " " + (body || "")).toLowerCase();
 // options.gateText narrows ONLY the spam and sentiment gates. On a forwarded
 // email the caller passes the covering note, so angry wording or a quoted
 // newsletter footer inside the FORWARDED text cannot stop Ethan answering.
 // Product and category detection below still read the full text.
 var gateText = options.gateText === undefined ? text : ((subject || "") + " " + options.gateText).toLowerCase();
 var gateBody = options.gateText === undefined ? body : options.gateText;
 var intent = detectCustomerProductIntent_(text);
 var category = "General";
 var reason = "No strong category pattern matched";
 var confidence = intent.strongScore > 0 ? 0.7 : (intent.score > 0 ? 0.5 : 0.35);
 var shouldSkip = false;
 var shouldEscalate = false;
 var escalationReason = "";

 if (isObviousSpam_(gateText)) {
  category = "Spam";
  reason = "Matched spam / bulk email pattern";
  confidence = 0.9;
  shouldSkip = true;
 } else if (needsHumanEscalation_(subject, gateBody)) {
  category = "Escalate";
  reason = "Matched negative sentiment or high-risk language";
  confidence = 0.9;
  shouldEscalate = true;
  escalationReason = "Sentiment / risk escalation";
 } else if (containsAnyText_(text, PRICING_KEYWORDS)) {
  category = "Pricing";
  reason = "Matched pricing / quotation terms";
  confidence = 0.85;
 } else if (containsAnyText_(text, ["install", "installation", "setup", "integrate", "integration", "configure", "configuration", "user guide", "manual"])) {
  category = "Installation";
  reason = "Matched installation / setup terms";
  confidence = 0.8;
 } else if (containsAnyText_(text, ["compatible", "compatibility", "processor", "cpu", "requirement", "requirements", "windows 11", "ram", "laptop"])) {
  category = "Compatibility";
  reason = "Matched compatibility / requirement terms";
  confidence = 0.8;
 } else if (containsAnyText_(text, ["trial", "demo", "free trial", "evaluation", "test license", "try"])) {
  category = "Demo / Trial";
  reason = "Matched demo / trial terms";
  confidence = 0.8;
 } else if (containsAnyText_(text, ["issue", "problem", "error", "bug", "not working", "failed", "failure", "support", "help"])) {
  category = "Technical Support";
  reason = "Matched support / issue terms";
  confidence = 0.8;
 }

 return {
  category: category,
  productLine: intent.label,
  productScore: intent.score,
  productTerms: intent.terms || [],
  strongTerms: intent.strongTerms || [],
  weakTerms: intent.weakTerms || [],
  strongProductScore: intent.strongScore || 0,
  weakProductScore: intent.weakScore || 0,
  confidence: confidence,
  shouldSkip: shouldSkip,
  shouldEscalate: shouldEscalate,
  escalationReason: escalationReason,
  reason: reason,
 };
}

function isObviousSpam_(text) {
 return containsAnyText_(text, [
  "unsubscribe", "newsletter", "limited time offer", "seo services",
  "guest post", "casino", "crypto investment", "marketing list",
  "bulk email", "webinar invitation", "do not reply", "noreply",
 ]);
}

function shouldEscalateReply_(replyHtml) {
 // If the reply PROMISES the customer that their question was passed to a
 // human team, the system must actually perform that forward. Match the
 // promise broadly - a promised-but-not-performed forward is a silent lie
 // that strands the customer (and stranded Jeanette for a week).
 var text = replyHtml.toLowerCase();
 return /(?:forwarded|shared|passed(?:\s+on)?|raised)\s+(?:your|this|their)\s+(?:query|question|questions|request|message|enquiry|inquiry)/i.test(text)
  // Passive voice: "your request has been forwarded to the internal team".
  || /(?:query|question|questions|request|message|enquiry|inquiry)\s+(?:has|have)\s+been\s+(?:forwarded|shared|passed(?:\s+on)?|raised|escalated|sent)/i.test(text)
  || /forwarded\s+to\s+(?:our|the)\s+(?:internal\s+)?team/i.test(text)
  || /(?:with|to)\s+our\s+(?:technical\s+|product\s+|firmware\s+)?team\s+for\s+(?:details|clarification|confirmation|a\s+detailed)/i.test(text)
  || text.indexOf("someone will follow up") >= 0
  || text.indexOf("internal team who will follow up") >= 0
  || text.indexOf("we will follow up with the confirmed specifics") >= 0;
}

function isKnowledgeContextStrongEnough_(knowledgeContext, classification, subject, body) {
 if (!knowledgeContext || !knowledgeContext.text) return false;
 if (!classification || classification.productLine === "General X-PHY") return true;

 // Multi-topic emails: don't let one weak sub-topic block Claude from
 // answering the parts that DO have documentation. The per-question
 // answer/defer rules in SYSTEM_PROMPT handle the rest once Claude runs.
 var combinedText = normalizeProductPhrases_((subject || "") + " " + (body || ""));
 if (detectCustomerProductIntents_(combinedText).length > 1) {
  return knowledgeContext.docsUsed > 0
   && stripLowValueKnowledgeMarkers_(knowledgeContext.text).length >= CONFIG.MIN_KB_CONTEXT_CHARS_FOR_DIRECT_REPLY;
 }

 var text = stripLowValueKnowledgeMarkers_(knowledgeContext.text);
 if (knowledgeContext.docsUsed <= 0) return false;
 if (text.length < CONFIG.MIN_KB_CONTEXT_CHARS_FOR_DIRECT_REPLY) return false;

 var product = normalizeExclusionName_(classification.productLine);
 var context = normalizeExclusionName_(text + " " + (knowledgeContext.filesUsed || "") + " " + classification.productLine);
 if (product === "server defender" && context.indexOf("server defender") < 0 && context.indexOf("defender") < 0) return false;
 if (product === "deepfake detector" && context.indexOf("deepfake") < 0 && context.indexOf("dfd") < 0) return false;
 if (product === "secure ssd" && context.indexOf("ssd") < 0 && context.indexOf("solid state") < 0 && context.indexOf("secure ssd") < 0) return false;
 if (product === "guard pc application" && context.indexOf("guard") < 0) return false;
 return true;
}

function stripLowValueKnowledgeMarkers_(text) {
 return String(text || "")
  .replace(/\[Image file available for inline embedding:[^\]]+\]/g, "")
