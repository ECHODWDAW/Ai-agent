function getRequestedSsdCapacityLock_(subject, body) {
 // Returns a lock only when the customer named EXACTLY ONE capacity.
 // Both named, or neither named, returns null and existing behavior
 // (show both) stays untouched.
 var text = ((subject || "") + " " + (body || "")).toLowerCase();
 var wants1tb = /\b1\s*tb\b/.test(text);
 var wants512 = /\b512\s*gb\b/.test(text);
 if (wants1tb && !wants512) return { keep: "1TB", drop: "512" };
 if (wants512 && !wants1tb) return { keep: "512GB", drop: "1tb" };
 return null;
}

function enforceRequestedCapacityColumns_(html, subject, body) {
 // Deterministic backstop: when the customer asked for one capacity but the
 // reply's pricing table carries a column for the other, remove that column
 // (header cell + every data cell beneath it). Safe by construction:
 // - Only fires when getRequestedSsdCapacityLock_ returns a lock.
 // - Only touches tables whose HEADER ROW contains the unwanted capacity,
 //   so the Guard series feature matrix, one-dimensional subscription
 //   tables, and any non-capacity table pass through byte-identical.
 // - Emits plain <table><tr><td> structure; formatPricingTables_ restyles
 //   it afterwards, so this pass must run BEFORE formatPricingTables_.
 var lock = getRequestedSsdCapacityLock_(subject, body);
 if (!lock) return html;
 var cleaned = String(html || "");
 if (cleaned.toLowerCase().indexOf("<table") < 0) return cleaned;

 var changed = false;
 cleaned = cleaned.replace(/<table\b[^>]*>([\s\S]*?)<\/table>/gi, function(tableMatch, tableBody) {
  var rows = [];
  tableBody.replace(/<tr\b[^>]*>([\s\S]*?)<\/tr>/gi, function(rowMatch, rowBody) {
   var cells = [];
   rowBody.replace(/<(td|th)\b[^>]*>([\s\S]*?)<\/\1>/gi, function(cellMatch, tagName, content) {
    cells.push(content);
    return cellMatch;
   });
   if (cells.length > 0) rows.push(cells);
   return rowMatch;
  });
  if (rows.length === 0) return tableMatch;

  // Identify unwanted capacity columns from the header row only.
  var header = rows[0];
  var dropCols = {};
  for (var c = 0; c < header.length; c++) {
   var cellText = String(header[c] || "").replace(/<[^>]+>/g, "").toLowerCase();
   if (lock.drop === "512" && /\b512\s*gb\b/.test(cellText)) dropCols[c] = true;
   if (lock.drop === "1tb" && /\b1\s*tb\b/.test(cellText)) dropCols[c] = true;
  }
  if (Object.keys(dropCols).length === 0) return tableMatch; // not a capacity table

  changed = true;
  var rebuilt = "";
  for (var r = 0; r < rows.length; r++) {
   var rowHtml = "";
   for (var c2 = 0; c2 < rows[r].length; c2++) {
    if (dropCols[c2]) continue;
    rowHtml += "<td>" + rows[r][c2] + "</td>";
   }
   if (rowHtml) rebuilt += "<tr>" + rowHtml + "</tr>";
  }
  return "<table>" + rebuilt + "</table>";
 });

 if (changed) {
  log(" Removed unrequested capacity column(s); customer asked for " + lock.keep + " only");
 }
 return cleaned;
}


function normalizeTeamWording_(html) {
 // Deterministic wording policy: any forwarding, follow-up, or contact
 // mention of "sales team" is rewritten to "internal team", regardless of
 // whether the model, a knowledge doc, or an editable sheet rule produced
 // it. Scoped to those contexts on purpose - a customer's OWN sales team
 // ("equipping your sales team") is never touched because the patterns
 // require to/with/by/contact + our/the immediately before the phrase, or
 // "sales team ... will" follow-up constructions.
 return String(html || "")
  .replace(/\b(to|with|by)(\s+(?:our|the))?\s+sales(\s+team)\b/gi, "$1$2 internal$3")
  .replace(/\bsales(\s+team\b\s*(?:,\s*)?(?:who\s+|and\s+they\s+)?will\b)/gi, "internal$1")
  .replace(/\b(contact(?:ing)?\s+(?:our|the)\s+)sales(\s+team)\b/gi, "$1internal$2");
}

// Deterministic safety net for the capability boundary. The model is told not
// to claim actions it cannot perform (tracking a signup, promising a 48h
// follow-up, "looping in" a named colleague, etc.), but it still drifts into
// agreeable confabulation. This removes any sentence that makes such a claim
// and, if it removed one, adds a single honest capability line so the reply
// still reads cleanly. Runs on the assembled reply body.
var FALSE_ACTION_CLAIM_PATTERNS_ = [
  /\bI(?:'ve| have|'ll| will|'m going to| am going to)\s+(?:noted|logged|recorded|registered|tracked|captured|flagged|scheduled|arranged|set up|forwarded|passed|escalated|looped|notified|informed|alerted|assigned|added|cc'?d)\b[^.!?<]*/i,
  /\bI(?:'ll| will)\s+(?:ensure|make sure|see to it)\b[^.!?<]*\b(?:reach out|follow up|followed up|contact|onboard|loop|notify|inform)\b[^.!?<]*/i,
  /\bwe(?:'ll| will)\s+(?:reach out|follow up|get back|be in touch|contact you|onboard)\b[^.!?<]*/i,
  /\b(?:I(?:'ll| will)|we(?:'ll| will))\s+loop\b[^.!?<]*/i,
  /\bloop(?:ing)?\s+in\s+[A-Z][a-z]+[^.!?<]*/,
  /\b(?:I(?:'ll| will)|we(?:'ll| will))\s+follow\s+up\b[^.!?<]*/i,
  /\bfollow(?:ing)?\s+up\s+within\s+\d+\s*(?:h|hr|hrs|hour|hours|day|days)\b[^.!?<]*/i,
  /\bI(?:'ve| have)\s+noted\s+that\b[^.!?<]*/i,
  /\bthey(?:'ll| will)\s+follow\s+up\b[^.!?<]*/i,
  /\bfollow\s+up\s+with\s+a\s+(?:tailored\s+)?quote\b[^.!?<]*/i,
  /\b(?:please\s+)?have\s+the\s+(?:sales|internal)\s+team\s+review\b[^.!?<]*/i,
  /\b(?:our\s+)?(?:sales|internal)\s+team\s+will\s+(?:follow\s+up|review|be\s+in\s+touch|reach\s+out)\b[^.!?<]*/i,
];

function sentenceMakesFalseActionClaim_(sentence) {
 for (var i = 0; i < FALSE_ACTION_CLAIM_PATTERNS_.length; i++) {
  if (FALSE_ACTION_CLAIM_PATTERNS_[i].test(sentence)) return true;
 }
 return false;
}

function stripFalseActionClaims_(html) {
 var input = String(html || "");
 var removedAny = false;
 // Work paragraph by paragraph so we never cross a <br><br> boundary.
 var paragraphs = input.split(/(<br\s*\/?>\s*){2,}/i);
 var rebuilt = input.split(/((?:<br\s*\/?>\s*){2,})/i).map(function (chunk) {
  if (/^(?:<br\s*\/?>\s*){2,}$/i.test(chunk)) return chunk; // keep separators
  // Split the paragraph into sentences, keeping trailing punctuation.
  var parts = chunk.split(/(?<=[.!?])\s+/);
  var kept = parts.filter(function (sentence) {
   var plain = sentence.replace(/<[^>]+>/g, " ");
   if (sentenceMakesFalseActionClaim_(plain)) { removedAny = true; return false; }
   return true;
  });
  return kept.join(" ");
 }).join("");

 if (!removedAny) return input;

 // Tidy any empty paragraphs left behind, then ensure one honest capability line.
 rebuilt = rebuilt.replace(/(?:<br\s*\/?>\s*){3,}/gi, "<br><br>");
 var disclaimer = "For the request itself, please reach out to our internal team directly and they'll be able to help you further.";
 if (rebuilt.toLowerCase().indexOf("reach out to our internal team") < 0) {
  // Insert just before the sign-off if we can find it, else prepend.
  var signOffAt = rebuilt.search(/best regards/i);
  if (signOffAt >= 0) {
   rebuilt = rebuilt.slice(0, signOffAt) + disclaimer + "<br><br>" + rebuilt.slice(signOffAt);
  } else {
   rebuilt = disclaimer + "<br><br>" + rebuilt;
  }
 }
 log(" Capability guard: removed false action claim(s) from reply and added the honest capability line.");
 return rebuilt;
}

function postProcessAiReply_(replyHtml, subject, body, senderName) {
 var cleaned = (replyHtml || "").trim();
 cleaned = stripMarkdownCodeFence_(cleaned);
 cleaned = sanitizeAiHtmlFragment_(cleaned);
 cleaned = normalizeTeamWording_(cleaned); // Policy: forwarding/follow-up mentions always say "internal team", even if the model writes "sales team" from habit.
 cleaned = stripFalseActionClaims_(cleaned); // Capability guard: strip confabulated actions (tracking, 48h follow-up, "loop in <name>").
 cleaned = removeLeadingHtmlLabel_(cleaned);
 cleaned = removeButtonStyleLinks_(cleaned);
 cleaned = stripSelfReferralContact_(cleaned);
