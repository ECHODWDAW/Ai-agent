 return haystack.indexOf("x-phy") >= 0
  && (haystack.indexOf("datasheet") >= 0
   || haystack.indexOf("data sheet") >= 0
   || haystack.indexOf("brochure") >= 0
   || haystack.indexOf("product") >= 0);
}

function isImageSourceFile_(fileMeta) {
 return isImageMimeType_(fileMeta.mimeType) || fileMeta.mimeType === "application/vnd.google-apps.document";
}

function getFolderTextForFile_(fileMeta) {
 var names = [];
 if (fileMeta.parentNames && fileMeta.parentNames.length > 0) {
  names = names.concat(fileMeta.parentNames);
 }
 var parentIds = fileMeta.parentIds || [];
 for (var i = 0; i < parentIds.length; i++) {
  if (APPROVED_FOLDERS[parentIds[i]]) names.push(APPROVED_FOLDERS[parentIds[i]]);
